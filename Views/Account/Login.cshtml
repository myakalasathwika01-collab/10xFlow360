@model _10xFlow360.Models.LoginVM

@{
    Layout = null;
    ViewBag.Title = "Login";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>10X Flow360 - Login</title>

    <!-- Bootstrap / Common CSS -->
    @Styles.Render("~/Content/css")

    <!-- Login-specific CSS -->
    <link rel="stylesheet"
          href="@Url.Content("~/Content/css/login/login.css")" />

</head>

<body class="login-page">

    <div class="login-wrapper">

        <div class="login-card">


            <!-- =================================================
                 BRAND / LOGO
                 ================================================= -->

            <div class="login-brand">

                <div class="login-logo-container">

                    <img src="@Url.Content("~/Content/img/10x.png")"
                         class="login-logo-10x"
                         alt="10X" />

                    <img src="@Url.Content("~/Content/img/10Xflow360.png")"
                         class="login-logo-flow360"
                         alt="Flow360" />

                </div>

                <p class="login-brand-subtitle">
                    SAP Business Process Automation
                </p>

            </div>


            <!-- =================================================
                 LOGIN FORM
                 ================================================= -->

            @using (Html.BeginForm(
                "Login",
                "Account",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new
                    {
                        @class = "validation-summary"
                    }
                )


                <!-- USERNAME -->

                <div class="login-form-group">

                    @Html.LabelFor(
                        model => model.UserName,
                        new
                        {
                            @class = "login-form-label"
                        }
                    )

                    @Html.TextBoxFor(
                        model => model.UserName,
                        new
                        {
                            @class = "login-form-control",
                            placeholder = "Enter username",
                            autocomplete = "username"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.UserName,
                        "",
                        new
                        {
                            @class = "field-validation-error"
                        }
                    )

                </div>


                <!-- PASSWORD -->

                <div class="login-form-group">

                    @Html.LabelFor(
                        model => model.Password,
                        new
                        {
                            @class = "login-form-label"
                        }
                    )

                    @Html.PasswordFor(
                        model => model.Password,
                        new
                        {
                            @class = "login-form-control",
                            placeholder = "Enter password",
                            autocomplete = "current-password"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.Password,
                        "",
                        new
                        {
                            @class = "field-validation-error"
                        }
                    )

                </div>


                <!-- REMEMBER ME -->

                <div class="login-remember-row">

                    <label>

                        @Html.CheckBoxFor(
                            model => model.RememberMe
                        )

                        <span>Remember me</span>

                    </label>

                </div>


                <!-- LOGIN BUTTON -->

                <button type="submit"
                        class="login-button">

                    Login

                </button>

            }


            <!-- =================================================
                 FOOTER
                 ================================================= -->

            <div class="login-footer">

                © @DateTime.Now.Year 10X Flow360

            </div>


        </div>

    </div>


    @Scripts.Render("~/bundles/jquery")

    @Scripts.Render("~/bundles/bootstrap")

</body>

</html>