@model _10xFlow360.Models.Dashboard

@{
    ViewBag.Title = "Process Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid ps-0">

    <!-- =========================================================
         MAIN DASHBOARD CARD
         ========================================================= -->

    <div class="card border-0 shadow-sm">

        <!-- =====================================================
             MAIN CARD BODY
             ===================================================== -->

        <div class="card-body">

            <!-- =================================================
                 DASHBOARD HEADER
                 ================================================= -->

            <div class="row align-items-center mb-4">

                <!-- TITLE -->

                <div class="col-md-7">

                    <h4 class="mb-1 fw-semibold text-dark">
                        Process Dashboard
                    </h4>

                    <p class="mb-0 text-muted small">
                        Design, automate and track your SAP Business One processes
                    </p>

                </div>


                <!-- RIGHT SIDE -->

                <div class="col-md-5">

                    <div class="d-flex
                                justify-content-md-end
                                align-items-center
                                gap-2
                                mt-3 mt-md-0">

                        <!-- SAP STATUS -->

                        <span class="badge bg-success px-3 py-2">

                            <i class="fa-solid fa-circle me-1"
                               style="font-size:7px;">
                            </i>

                            SAP Connected

                        </span>


                        <!-- ADMINISTRATOR -->

                        <div class="dropdown">

                            <button class="btn btn-flow-pink dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <i class="fa-regular fa-user me-2"></i>

                                Administrator

                            </button>


                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>

                                    <a class="dropdown-item" href="#">

                                        <i class="fa-regular fa-user me-2"></i>

                                        Profile

                                    </a>

                                </li>


                                <li>

                                    <a class="dropdown-item" href="#">

                                        <i class="fa-solid fa-gear me-2"></i>

                                        Settings

                                    </a>

                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 KPI CARDS
                 ================================================= -->

            <div class="row g-3 mb-4">


                <!-- =================================================
                     ACTIVE WORKFLOWS
                     ================================================= -->

                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="card border shadow-sm h-100 dashboard-kpi-card">

                        <div class="card-body">

                            <div class="d-flex
                                        justify-content-between
                                        align-items-start">

                                <div>

                                    <div class="text-muted
                                                text-uppercase
                                                small
                                                fw-semibold
                                                mb-2">

                                        Active Workflows

                                    </div>


                                    <div class="fs-3 fw-bold text-dark">

                                        @Model.ActiveWorkflows

                                    </div>


                                    <div class="small text-success mt-2">

                                        <i class="fa-solid fa-circle-check me-1"></i>

                                        @Model.CurrentlyProcessing currently processing

                                    </div>

                                </div>


                                <div class="bg-flow-pink-subtle
                                            text-flow-pink
                                            rounded
                                            p-3">

                                    <i class="fa-solid fa-diagram-project fs-5"></i>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     RUNNING INSTANCES
                     ================================================= -->

                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="card border shadow-sm h-100 dashboard-kpi-card">

                        <div class="card-body">

                            <div class="d-flex
                                        justify-content-between
                                        align-items-start">

                                <div>

                                    <div class="text-muted
                                                text-uppercase
                                                small
                                                fw-semibold
                                                mb-2">

                                        Running Instances

                                    </div>


                                    <div class="fs-3 fw-bold text-dark">

                                        @Model.RunningInstances

                                    </div>


                                    <div class="small text-muted mt-2">

                                        Across all processes

                                    </div>

                                </div>


                                <div class="bg-info-subtle
                                            text-info
                                            rounded
                                            p-3">

                                    <i class="fa-solid fa-play fs-5"></i>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     COMPLETED TODAY
                     ================================================= -->

                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="card border shadow-sm h-100 dashboard-kpi-card">

                        <div class="card-body">

                            <div class="d-flex
                                        justify-content-between
                                        align-items-start">

                                <div>

                                    <div class="text-muted
                                                text-uppercase
                                                small
                                                fw-semibold
                                                mb-2">

                                        Completed Today

                                    </div>


                                    <div class="fs-3 fw-bold text-dark">

                                        @Model.CompletedToday

                                    </div>


                                    <div class="small text-success mt-2">

                                        <i class="fa-solid fa-arrow-up me-1"></i>

                                        @Model.CompletedPercentage%

                                    </div>

                                </div>


                                <div class="bg-success-subtle
                                            text-success
                                            rounded
                                            p-3">

                                    <i class="fa-solid fa-check fs-5"></i>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     OVERDUE
                     ================================================= -->

                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="card border shadow-sm h-100 dashboard-kpi-card">
                        <div class="card-body">

                            <div class="d-flex
                                        justify-content-between
                                        align-items-start">

                                <div>

                                    <div class="text-muted
                                                text-uppercase
                                                small
                                                fw-semibold
                                                mb-2">

                                        Overdue

                                    </div>


                                    <div class="fs-3 fw-bold text-dark">

                                        @Model.Overdue

                                    </div>


                                    <div class="small text-danger mt-2">

                                        <i class="fa-solid fa-triangle-exclamation me-1"></i>

                                        Requires attention

                                    </div>

                                </div>


                                <div class="bg-danger-subtle
                                            text-danger
                                            rounded
                                            p-3">

                                    <i class="fa-solid fa-exclamation fs-5"></i>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 ACTIVE PROCESSES + PROCESS HEALTH
                 ================================================= -->

            <div class="row g-3">


                <!-- =================================================
                     ACTIVE PROCESSES
                     ================================================= -->

                <div class="col-12 col-xl-8">

                    <div class="card border shadow-sm h-100">

                        <!-- CARD HEADER -->

                        <div class="card-header bg-white
                                    d-flex
                                    justify-content-between
                                    align-items-center">

                            <h5 class="mb-0 fw-semibold">

                                Active Processes

                            </h5>


                            @*<button type="button"
                class="btn btn-flow-pink btn-sm">

            <i class="fa-solid fa-plus me-1"></i>

            New Workflow

        </button>*@
                            <a href="@Url.Action("Index", "Workflow")"
                               class="btn btn-primary">

                                <i class="bi bi-plus-lg"></i>

                                New Workflow

                            </a>

                        </div>


                        <!-- CARD BODY -->

                        <div class="card-body p-0">

                            <div class="table-responsive">

                                <table class="table
                                              table-hover
                                              align-middle
                                              mb-0">

                                    <thead class="table-light">

                                        <tr>

                                            <th class="px-3">
                                                Workflow
                                            </th>

                                            <th>
                                                Module
                                            </th>

                                            <th>
                                                Running
                                            </th>

                                            <th>
                                                Completed
                                            </th>

                                            <th>
                                                Status
                                            </th>

                                        </tr>

                                    </thead>


                                    <tbody>

                                        @foreach (var process in Model.ActiveProcesses)
                                        {
                                            <tr>

                                                <!-- WORKFLOW -->

                                                <td class="px-3">

                                                    <div class="fw-semibold text-dark">

                                                        @process.Workflow

                                                    </div>

                                                    <small class="text-muted">

                                                        @process.WorkflowCode

                                                    </small>

                                                </td>


                                                <!-- MODULE -->

                                                <td>

                                                    @process.Module

                                                </td>


                                                <!-- RUNNING -->

                                                <td>

                                                    @process.Running

                                                </td>


                                                <!-- COMPLETED -->

                                                <td>

                                                    @process.Completed

                                                </td>


                                                <!-- STATUS -->

                                                <td>

                                                    <span class="badge
                                                                 bg-flow-pink-subtle
                                                                 text-flow-pink
                                                                 rounded-pill
                                                                 px-3
                                                                 py-2">

                                                        @process.Status

                                                    </span>

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     PROCESS HEALTH
                     ================================================= -->

                <div class="col-12 col-xl-4">

                    <div class="card border shadow-sm h-100">

                        <!-- CARD HEADER -->

                        <div class="card-header bg-white border-0">

                            <h5 class="mb-0 fw-semibold">

                                Process Health

                            </h5>

                        </div>


                        <!-- CARD BODY -->

                        <div class="card-body">

                            <!-- SLA COMPLIANCE -->

                            <div class="mb-4">

                                <div class="d-flex
                                            justify-content-between
                                            align-items-center
                                            mb-2">

                                    <span class="small text-dark">
                                        SLA Compliance
                                    </span>

                                    <strong class="small">
                                        @Model.SlaCompliance%
                                    </strong>

                                </div>


                                <div class="progress"
                                     style="height:7px;">

                                    <div class="progress-bar bg-flow-pink"
                                         role="progressbar"
                                         style="width:@Model.SlaCompliance%;"
                                         aria-valuenow="@Model.SlaCompliance"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>

                                </div>

                            </div>


                            <!-- COMPLETED ON TIME -->

                            <div class="mb-4">

                                <div class="d-flex
                                            justify-content-between
                                            align-items-center
                                            mb-2">

                                    <span class="small text-dark">

                                        Completed On Time

                                    </span>

                                    <strong class="small">

                                        @Model.CompletedOnTime%

                                    </strong>

                                </div>


                                <div class="progress"
                                     style="height:7px;">

                                    <div class="progress-bar bg-primary"
                                         role="progressbar"
                                         style="width:@Model.CompletedOnTime%;"
                                         aria-valuenow="@Model.CompletedOnTime"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>

                                </div>

                            </div>


                            <!-- ESCALATED -->

                            <div>

                                <div class="d-flex
                                            justify-content-between
                                            align-items-center
                                            mb-2">

                                    <span class="small text-dark">

                                        Escalated

                                    </span>

                                    <strong class="small">

                                        @Model.Escalated%

                                    </strong>

                                </div>


                                <div class="progress"
                                     style="height:7px;">

                                    <div class="progress-bar bg-danger"
                                         role="progressbar"
                                         style="width:@Model.Escalated%;"
                                         aria-valuenow="@Model.Escalated"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     PAGE STYLES
     ============================================================= -->

<style>

    /* =========================================================
       FLOW360 PINK BUTTON
       ========================================================= */

    .btn-flow-pink {
        background-color: #e91e63;
        border-color: #e91e63;
        color: #ffffff;
        font-weight: 500;
    }

        .btn-flow-pink:hover,
        .btn-flow-pink:focus {
            background-color: #d81b60;
            border-color: #d81b60;
            color: #ffffff;
        }


    /* =========================================================
       FLOW360 COLORS
       ========================================================= */

    .bg-flow-pink {
        background-color: #e91e63 !important;
    }

    .text-flow-pink {
        color: #e91e63 !important;
    }

    .bg-flow-pink-subtle {
        background-color: #fce4ec !important;
    }


    /* =========================================================
       KPI CARD MOVEMENT
       ========================================================= */

    .dashboard-kpi-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }


        .dashboard-kpi-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
</style>