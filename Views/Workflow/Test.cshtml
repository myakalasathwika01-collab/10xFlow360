@{
    ViewBag.Title = "Workflow Testing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


<div class="container-fluid ps-0">

    <div class="card shadow-sm border-0">

        <div class="card-body">


            <!-- =====================================================
                 TOP HEADER
                 ===================================================== -->

            @*<div class="d-flex flex-wrap align-items-center justify-content-between
                        border-bottom pb-3 mb-4">

                <div>

                    <h2 class="h5 mb-1 text-dark fw-semibold">
                        Workflow Automation Testing
                    </h2>

                    <p class="mb-0 text-muted small">
                        Design, automate and track your SAP Business One processes
                    </p>

                </div>


                <div class="d-flex align-items-center gap-3 mt-2 mt-md-0">

                    <div class="badge bg-success px-3 py-2">

                        <i class="bi bi-circle-fill me-1"></i>

                        SAP Connected

                    </div>


                    <div class="btn btn-primary px-3">
                        <i class="bi bi-person me-1"></i>
                        Administrator
                        <i class="bi bi-caret-down-fill ms-1"></i>
                    </div>
                </div>

            </div>*@



            <!-- =====================================================
                 PAGE TITLE
                 ===================================================== -->

            <div class="d-flex flex-wrap align-items-center
                        justify-content-between mb-4">

                <div>

                    <h1 class="h3 mb-1 text-dark fw-semibold">
                        Workflow Testing
                    </h1>

                    <p class="mb-0 text-muted">
                        Simulate the process before publishing it.
                    </p>

                </div>

                <button type="button"
                        class="btn btn-primary px-4 mt-3 mt-md-0"
                        onclick="runWorkflowTest()">

                    <i class="bi bi-play-fill me-1"></i>

                    Run Test

                </button>

            </div>



            <!-- =====================================================
                 MAIN GRID
                 ===================================================== -->

            <div class="row g-4">


                <!-- =================================================
                     LEFT COLUMN
                     ================================================= -->

                <div class="col-xl-5 col-lg-5">


                    <!-- =============================================
                         TEST DATA
                         ============================================= -->

                    <div class="card border shadow-sm">

                        <div class="card-header bg-white border-0">

                            <h3 class="h6 mb-0 fw-semibold text-dark">
                                Test Data
                            </h3>

                        </div>


                        <div class="card-body">


                            <div class="mb-3">

                                <label for="salesOrderNumber"
                                       class="form-label fw-medium">

                                    Sales Order Number

                                </label>

                                <input type="text"
                                       id="salesOrderNumber"
                                       name="salesOrderNumber"
                                       value="10345"
                                       class="form-control" />

                            </div>



                            <div class="mb-3">

                                <label for="customer"
                                       class="form-label fw-medium">

                                    Customer

                                </label>

                                <input type="text"
                                       id="customer"
                                       name="customer"
                                       value="ABC Trading LLC"
                                       class="form-control" />

                            </div>



                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label for="amount"
                                           class="form-label fw-medium">

                                        Amount

                                    </label>

                                    <input type="text"
                                           id="amount"
                                           name="amount"
                                           value="AED 25,850"
                                           class="form-control" />

                                </div>


                                <div class="col-md-6">

                                    <label for="salesman"
                                           class="form-label fw-medium">

                                        Salesman

                                    </label>

                                    <input type="text"
                                           id="salesman"
                                           name="salesman"
                                           value="John"
                                           class="form-control" />

                                </div>

                            </div>


                        </div>

                    </div>



                    <!-- =============================================
                         EXECUTION STEPS
                         ============================================= -->

                    <div class="card border shadow-sm mt-4">

                        <div class="card-header bg-white border-0">

                            <h3 class="h6 mb-0 fw-semibold text-dark">
                                Execution Steps
                            </h3>

                        </div>


                        <div class="card-body p-4">


                            <!-- STEP 1 -->

                            <div class="d-flex mb-4">

                                <div class="border-start border-3 border-primary ps-3">

                                    <strong class="d-block text-dark">
                                        1. Sales Order Created
                                    </strong>

                                    <span class="text-muted small">
                                        Detect SAP Sales Order
                                    </span>

                                </div>

                            </div>



                            <!-- STEP 2 -->

                            <div class="d-flex mb-4">

                                <div class="border-start border-3 border-success ps-3">

                                    <strong class="d-block text-dark">
                                        2. Notify Delivery Team
                                    </strong>

                                    <span class="text-muted small">
                                        Simulated notification
                                    </span>

                                </div>

                            </div>



                            <!-- STEP 3 -->

                            <div class="d-flex mb-4">

                                <div class="border-start border-3 border-warning ps-3">

                                    <strong class="d-block text-dark">
                                        3. Delivery Date Updated
                                    </strong>

                                    <span class="text-muted small">
                                        Test user response
                                    </span>

                                </div>

                            </div>



                            <!-- STEP 4 -->

                            <div class="d-flex mb-4">

                                <div class="border-start border-3 border-warning ps-3">

                                    <strong class="d-block text-dark">
                                        4. Delivery Created
                                    </strong>

                                    <span class="text-muted small">
                                        SAP Delivery simulation
                                    </span>

                                </div>

                            </div>



                            <!-- STEP 5 -->

                            <div class="d-flex mb-4">

                                <div class="border-start border-3 border-warning ps-3">

                                    <strong class="d-block text-dark">
                                        5. Invoice Created
                                    </strong>

                                    <span class="text-muted small">
                                        SAP Invoice simulation
                                    </span>

                                </div>

                            </div>



                            <!-- STEP 6 -->

                            <div class="d-flex">

                                <div class="border-start border-3 border-success ps-3">

                                    <strong class="d-block text-dark">
                                        6. Accounts Notification
                                    </strong>

                                    <span class="text-muted small">
                                        Simulated notification
                                    </span>

                                </div>

                            </div>


                        </div>

                    </div>

                </div>



                <!-- =================================================
                     RIGHT COLUMN
                     ================================================= -->

                <div class="col-xl-7 col-lg-7">


                    <!-- =============================================
                         TEST CONSOLE
                         ============================================= -->

                    <div class="card border shadow-sm">

                        <div class="card-header bg-white
                                    d-flex align-items-center
                                    justify-content-between border-0">

                            <h3 class="h6 mb-0 fw-semibold text-dark">

                                <i class="bi bi-terminal me-2"></i>

                                Test Console

                            </h3>


                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    onclick="clearConsole()">

                                Clear

                            </button>

                        </div>


                        <div class="card-body p-0">

                            <div class="m-3 p-3 bg-dark text-light rounded-3
                                        font-monospace small overflow-auto"
                                 id="testConsole"
                                 style="height:390px;">

                                <div>
                                    10X Flow360 Test Engine Ready...
                                </div>

                                <div>
                                    Click "Run Test" to simulate the workflow.
                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- =============================================
                         NOTIFICATION PREVIEW
                         ============================================= -->

                    <div class="card border shadow-sm mt-4">

                        <div class="card-header bg-white border-0">

                            <h3 class="h6 mb-0 fw-semibold text-dark">
                                Test Notification Preview
                            </h3>

                        </div>


                        <div class="card-body p-4">


                            <div class="border rounded overflow-hidden">


                                <!-- WhatsApp Header -->

                                <div class="d-flex align-items-center p-3">

                                    <div class="rounded-circle bg-success
                                                text-white d-flex
                                                align-items-center
                                                justify-content-center
                                                flex-shrink-0"
                                         style="width:42px;height:42px;">

                                        <i class="bi bi-whatsapp fs-5"></i>

                                    </div>


                                    <div class="ms-3">

                                        <strong class="d-block text-dark">
                                            Delivery Team
                                        </strong>

                                        <span class="text-muted small">
                                            Test Message
                                        </span>

                                    </div>

                                </div>



                                <!-- WhatsApp Message -->

                                <div class="px-3 pb-3">

                                    <p class="fw-bold mb-3">
                                        New Sales Order requires action.
                                    </p>


                                    <p class="mb-2">

                                        Sales Order:

                                        <strong>
                                            10345
                                        </strong>

                                    </p>


                                    <p class="mb-2">

                                        Customer:

                                        <strong>
                                            ABC Trading LLC
                                        </strong>

                                    </p>


                                    <p class="mb-2">

                                        Amount:

                                        <strong>
                                            AED 25,850
                                        </strong>

                                    </p>


                                    <p class="mt-3 mb-0">

                                        Please update the expected delivery date.

                                    </p>

                                </div>



                                <!-- WhatsApp Footer -->

                                <div class="border-top px-3 py-3
                                            text-muted small">

                                    WhatsApp API integration will be connected
                                    during the integration phase.

                                </div>


                            </div>

                        </div>

                    </div>


                </div>

            </div>


        </div>

    </div>

</div>
<style>
    /* 10X Flow360 Pink Button */
    .btn-primary {
        background-color: #e91e63;
        border-color: #e91e63;
        color: #fff;
    }

        .btn-primary:hover,
        .btn-primary:focus,
        .btn-primary:active {
            background-color: #d81b60 !important;
            border-color: #d81b60 !important;
            color: #fff !important;
        }
</style>



<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->

@section Scripts {

    <script>

        function runWorkflowTest() {

            var consoleBox =
                document.getElementById("testConsole");

            var salesOrder =
                document.getElementById("salesOrderNumber").value;

            var customer =
                document.getElementById("customer").value;

            var amount =
                document.getElementById("amount").value;

            var salesman =
                document.getElementById("salesman").value;


            consoleBox.innerHTML = "";


            addConsoleLine(
                "10X Flow360 Test Engine Starting..."
            );


            setTimeout(function () {

                addConsoleLine(
                    "Sales Order " +
                    salesOrder +
                    " detected."
                );

            }, 400);


            setTimeout(function () {

                addConsoleLine(
                    "Customer: " +
                    customer
                );

            }, 800);


            setTimeout(function () {

                addConsoleLine(
                    "Amount: " +
                    amount
                );

            }, 1200);


            setTimeout(function () {

                addConsoleLine(
                    "Salesman: " +
                    salesman
                );

            }, 1600);


            setTimeout(function () {

                addConsoleLine(
                    "Step 1 completed: Sales Order Created."
                );

            }, 2000);


            setTimeout(function () {

                addConsoleLine(
                    "Step 2 completed: Delivery Team notified."
                );

            }, 2400);


            setTimeout(function () {

                addConsoleLine(
                    "Step 3 completed: Delivery Date Updated."
                );

            }, 2800);


            setTimeout(function () {

                addConsoleLine(
                    "Step 4 completed: Delivery Created."
                );

            }, 3200);


            setTimeout(function () {

                addConsoleLine(
                    "Step 5 completed: Invoice Created."
                );

            }, 3600);


            setTimeout(function () {

                addConsoleLine(
                    "Step 6 completed: Accounts notified."
                );

            }, 4000);


            setTimeout(function () {

                addConsoleLine(
                    "Workflow test completed successfully."
                );

            }, 4400);

        }



        function addConsoleLine(message) {

            var consoleBox =
                document.getElementById("testConsole");

            var line =
                document.createElement("div");

            line.textContent =
                message;

            consoleBox.appendChild(line);

            consoleBox.scrollTop =
                consoleBox.scrollHeight;

        }



        function clearConsole() {

            var consoleBox =
                document.getElementById("testConsole");

            consoleBox.innerHTML =
                "<div>10X Flow360 Test Engine Ready...</div>" +
                "<div>Click \"Run Test\" to simulate the workflow.</div>";

        }

    </script>

}