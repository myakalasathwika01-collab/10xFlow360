@{
    ViewBag.Title = "Workflow Designer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Bootstrap Icons -->

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="container-fluid">

    <!-- =========================================================
         MAIN CARD
         EVERYTHING IS INSIDE CARD-BODY
         ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body">


            <!-- =================================================
                 PAGE HEADER
                 ================================================= -->

            <div class="row align-items-center mb-4">

                <!-- TITLE -->

                <div class="col-md-7">

                    <h2 class="h4 fw-semibold text-dark mb-1">
                        Workflow Designer
                    </h2>

                    <p class="text-muted mb-0">
                        Design your SAP process using reusable workflow blocks.
                    </p>

                </div>


                <!-- BUTTONS -->

                <div class="col-md-5">

                    <div class="d-flex justify-content-md-end mt-3 mt-md-0">

                        <!-- SAVE DRAFT -->

                        @using (Html.BeginForm(
                            "SaveDraft",
                            "Workflow",
                            FormMethod.Post,
                            new { @class = "d-inline me-2" }))
                        {
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="workflowName"
                                   value="Sales Order to Invoice Follow-up" />

                            <input type="hidden"
                                   name="sapModule"
                                   value="Sales" />

                            <input type="hidden"
                                   name="company"
                                   value="10X Demo Company" />

                            <input type="hidden"
                                   name="version"
                                   value="V1.0" />

                            <button type="submit" class="btn btn-flow-pink">
                                <i class="bi bi-save me-1"></i>
                                Save Draft
                            </button>
                        }


                        <!-- TEST WORKFLOW -->

                        <a href="@Url.Action("Test", "Workflow")"
                           class="btn btn-success">

                            <i class="bi bi-play-fill me-1"></i>
                            Test Workflow

                        </a>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 ALERTS
                 ================================================= -->

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success d-flex align-items-center mb-3"
                     role="alert">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    <span>
                        @TempData["SuccessMessage"]
                    </span>

                </div>
            }


            @if (TempData["TestMessage"] != null)
            {
                <div class="alert alert-info d-flex align-items-center mb-3"
                     role="alert">

                    <i class="bi bi-info-circle-fill me-2"></i>

                    <span>
                        @TempData["TestMessage"]
                    </span>

                </div>
            }


            <!-- =================================================
                 WORKFLOW INFORMATION
                 ================================================= -->

            <div class="card border shadow-sm mb-4">

                <div class="card-body p-3">

                    <div class="row g-3">


                        <!-- WORKFLOW NAME -->

                        <div class="col-lg-4 col-md-6">

                            <label for="workflowName"
                                   class="form-label fw-medium">

                                Workflow Name

                            </label>

                            <input type="text"
                                   id="workflowName"
                                   class="form-control"
                                   value="Sales Order to Invoice Follow-up" />

                        </div>


                        <!-- SAP MODULE -->

                        <div class="col-lg-3 col-md-6">

                            <label for="sapModule"
                                   class="form-label fw-medium">

                                SAP Module

                            </label>

                            <select id="sapModule"
                                    class="form-select">

                                <option selected>
                                    Sales
                                </option>

                                <option>
                                    Purchase
                                </option>

                                <option>
                                    Inventory
                                </option>

                                <option>
                                    Finance
                                </option>

                                <option>
                                    Production
                                </option>

                                <option>
                                    Service
                                </option>

                            </select>

                        </div>


                        <!-- COMPANY -->

                        <div class="col-lg-3 col-md-6">

                            <label for="company"
                                   class="form-label fw-medium">

                                Company

                            </label>

                            <select id="company"
                                    class="form-select">

                                <option selected>
                                    10X Demo Company
                                </option>

                                <option>
                                    10X Production Company
                                </option>

                            </select>

                        </div>


                        <!-- VERSION -->

                        <div class="col-lg-2 col-md-6">

                            <label for="version"
                                   class="form-label fw-medium">

                                Version

                            </label>

                            <input type="text"
                                   id="version"
                                   class="form-control"
                                   value="V1.0"
                                   readonly />

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 WORKFLOW DESIGNER
                 COMPONENTS | CANVAS | PROPERTIES
                 ================================================= -->

            <div class="row g-3">


                <!-- =================================================
                     COMPONENTS
                     ================================================= -->

                <div class="col-xl-3 col-lg-3">

                    <div class="card border shadow-sm h-100">

                        <!-- HEADER -->

                        <div class="card-header bg-white border-0">

                            <h5 class="mb-0 fw-semibold">

                                <i class="bi bi-boxes me-2 text-primary"></i>

                                Components

                            </h5>

                        </div>


                        <!-- BODY -->

                        <div class="card-body p-3">


                            <!-- TRIGGER -->

                            <div class="mb-4">

                                <div class="text-uppercase text-muted small fw-semibold mb-2">
                                    Trigger
                                </div>


                                <button type="button"
                                        class="btn btn-light border w-100 text-start mb-2"
                                        onclick="addWorkflowNode('trigger')">

                                    <i class="bi bi-lightning-charge-fill text-primary me-2"></i>

                                    SAP Event

                                </button>


                                <button type="button"
                                        class="btn btn-light border w-100 text-start"
                                        onclick="addWorkflowNode('query')">

                                    <i class="bi bi-database-check text-primary me-2"></i>

                                    Query Trigger

                                </button>

                            </div>


                            <!-- LOGIC -->

                            <div class="mb-4">

                                <div class="text-uppercase text-muted small fw-semibold mb-2">
                                    Logic
                                </div>


                                <button type="button"
                                        class="btn btn-light border w-100 text-start mb-2"
                                        onclick="addWorkflowNode('condition')">

                                    <i class="bi bi-signpost-split text-info me-2"></i>

                                    Condition

                                </button>


                                <button type="button"
                                        class="btn btn-light border w-100 text-start"
                                        onclick="addWorkflowNode('wait')">

                                    <i class="bi bi-hourglass-split text-warning me-2"></i>

                                    Wait

                                </button>

                            </div>


                            <!-- ACTIONS -->

                            <div>

                                <div class="text-uppercase text-muted small fw-semibold mb-2">
                                    Actions
                                </div>


                                <!-- WHATSAPP -->

                                <button type="button"
                                        class="btn btn-light border w-100 text-start mb-2"
                                        onclick="addWorkflowNode('whatsapp')">

                                    <i class="bi bi-whatsapp text-success me-2"></i>

                                    WhatsApp

                                </button>


                                <!-- EMAIL -->

                                <button type="button"
                                        class="btn btn-light border w-100 text-start mb-2"
                                        onclick="addWorkflowNode('email')">

                                    <i class="bi bi-envelope text-danger me-2"></i>

                                    Email

                                </button>


                                <!-- ASSIGN TASK -->

                                <button type="button"
                                        class="btn btn-light border w-100 text-start mb-2"
                                        onclick="addWorkflowNode('task')">

                                    <i class="bi bi-person-check text-info me-2"></i>

                                    Assign Task

                                </button>


                                <!-- UPDATE SAP -->

                                <button type="button"
                                        class="btn btn-light border w-100 text-start"
                                        onclick="addWorkflowNode('update')">

                                    <i class="bi bi-pencil-square text-primary me-2"></i>

                                    Update SAP Field

                                </button>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     WORKFLOW CANVAS
                     ================================================= -->

                <div class="col-xl-6 col-lg-6">

                    <div class="card border shadow-sm h-100">

                        <div class="card-body p-3">


                            <div id="workflowFlow"
                                 class="d-flex flex-column align-items-center">


                                <!-- =================================
                                     NODE 1
                                     ================================= -->

                                <div class="workflow-node selected border border-primary rounded-3 bg-white shadow-sm p-3 w-100"
                                     data-node="trigger"
                                     onclick="selectWorkflowNode(this,'trigger')">

                                    <div class="d-flex align-items-center">


                                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3"
                                             style="width:42px;height:42px;">

                                            <i class="bi bi-lightning-charge-fill fs-5"></i>

                                        </div>


                                        <div class="flex-grow-1">

                                            <div class="workflow-node-title fw-semibold text-dark">
                                                Sales Order Created
                                            </div>

                                            <div class="workflow-node-subtitle small text-muted">
                                                SAP ORDR - New document created
                                            </div>

                                        </div>



                                        <!-- EDIT BUTTON -->
                                        <button type="button"
                                                class="btn btn-sm btn-warning text-dark ms-2 workflow-edit-btn"
                                                onclick="editWorkflowNode(event, this.closest('.workflow-node'), 'trigger')">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </button>
                                    </div>

                                </div>


                                <!-- CONNECTOR -->

                                <div class="py-2 text-secondary">

                                    <i class="bi bi-arrow-down fs-5"></i>

                                </div>


                                <!-- =================================
                                     NODE 2
                                     ================================= -->

                                <div class="workflow-node border rounded-3 bg-white shadow-sm p-3 w-100"
                                     data-node="notify"
                                     onclick="selectWorkflowNode(this,'notify')">

                                    <div class="d-flex align-items-center">


                                        <div class="rounded-3 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center me-3"
                                             style="width:42px;height:42px;">

                                            <i class="bi bi-whatsapp fs-5"></i>

                                        </div>


                                        <div class="flex-grow-1">

                                            <div class="workflow-node-title fw-semibold text-dark">
                                                Notify Delivery Team
                                            </div>

                                            <div class="workflow-node-subtitle small text-muted">
                                                Test notification - WhatsApp integration later
                                            </div>

                                        </div>



                                        <!-- EDIT BUTTON -->
                                        <button type="button"
                                                class="btn btn-sm btn-warning text-dark ms-2 workflow-edit-btn"
                                                onclick="editWorkflowNode(event, this.closest('.workflow-node'), 'notify')">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </button>
                                    </div>

                                </div>


                                <!-- CONNECTOR -->

                                <div class="py-2 text-secondary">

                                    <i class="bi bi-arrow-down fs-5"></i>

                                </div>


                                <!-- =================================
                                     NODE 3
                                     ================================= -->

                                <div class="workflow-node border rounded-3 bg-white shadow-sm p-3 w-100"
                                     data-node="delivery-date"
                                     onclick="selectWorkflowNode(this,'delivery-date')">

                                    <div class="d-flex align-items-center">


                                        <div class="rounded-3 bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center me-3"
                                             style="width:42px;height:42px;">

                                            <i class="bi bi-hourglass-split fs-5"></i>

                                        </div>


                                        <div class="flex-grow-1">

                                            <div class="workflow-node-title fw-semibold text-dark">
                                                Wait for Delivery Date
                                            </div>

                                            <div class="workflow-node-subtitle small text-muted">
                                                Continue when Expected Delivery Date is updated
                                            </div>

                                        </div>



                                        <!-- EDIT BUTTON -->
                                        <button type="button"
                                                class="btn btn-sm btn-warning text-dark ms-2 workflow-edit-btn"
                                                onclick="editWorkflowNode(event, this.closest('.workflow-node'), 'delivery-date')">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </button>
                                    </div>

                                </div>


                                <!-- CONNECTOR -->

                                <div class="py-2 text-secondary">

                                    <i class="bi bi-arrow-down fs-5"></i>

                                </div>


                                <!-- =================================
                                     NODE 4
                                     ================================= -->

                                <div class="workflow-node border rounded-3 bg-white shadow-sm p-3 w-100"
                                     data-node="delivery"
                                     onclick="selectWorkflowNode(this,'delivery')">

                                    <div class="d-flex align-items-center">


                                        <div class="rounded-3 bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center me-3"
                                             style="width:42px;height:42px;">

                                            <i class="bi bi-truck fs-5"></i>

                                        </div>


                                        <div class="flex-grow-1">

                                            <div class="workflow-node-title fw-semibold text-dark">
                                                Wait for Delivery
                                            </div>

                                            <div class="workflow-node-subtitle small text-muted">
                                                Monitor SAP Delivery created from Sales Order
                                            </div>

                                        </div>



                                        <!-- EDIT BUTTON -->
                                        <button type="button"
                                                class="btn btn-sm btn-warning text-dark ms-2 workflow-edit-btn"
                                                onclick="editWorkflowNode(event, this.closest('.workflow-node'), 'delivery')">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </button>
                                    </div>

                                </div>


                                <!-- CONNECTOR -->

                                <div class="py-2 text-secondary">

                                    <i class="bi bi-arrow-down fs-5"></i>

                                </div>


                                <!-- =================================
                                     NODE 5
                                     ================================= -->

                                <div class="workflow-node border rounded-3 bg-white shadow-sm p-3 w-100"
                                     data-node="invoice"
                                     onclick="selectWorkflowNode(this,'invoice')">

                                    <div class="d-flex align-items-center">


                                        <div class="rounded-3 bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center me-3"
                                             style="width:42px;height:42px;">

                                            <i class="bi bi-receipt fs-5"></i>

                                        </div>


                                        <div class="flex-grow-1">

                                            <div class="workflow-node-title fw-semibold text-dark">
                                                Wait for A/R Invoice
                                            </div>

                                            <div class="workflow-node-subtitle small text-muted">
                                                Monitor Invoice linked to Delivery
                                            </div>

                                        </div>



                                        <!-- EDIT BUTTON -->
                                        <button type="button"
                                                class="btn btn-sm btn-warning text-dark ms-2 workflow-edit-btn"
                                                onclick="editWorkflowNode(event, this.closest('.workflow-node'), 'invoice')">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </button>
                                    </div>

                                </div>


                                <!-- CONNECTOR -->

                                <div class="py-2 text-secondary">

                                    <i class="bi bi-arrow-down fs-5"></i>

                                </div>


                                <!-- =================================
                                     NODE 6
                                     ================================= -->

                                <div class="workflow-node border rounded-3 bg-white shadow-sm p-3 w-100"
                                     data-node="accounts"
                                     onclick="selectWorkflowNode(this,'accounts')">

                                    <div class="d-flex align-items-center">


                                        <div class="rounded-3 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center me-3"
                                             style="width:42px;height:42px;">

                                            <i class="bi bi-bell-fill fs-5"></i>

                                        </div>


                                        <div class="flex-grow-1">

                                            <div class="workflow-node-title fw-semibold text-dark">
                                                Notify Accounts
                                            </div>

                                            <div class="workflow-node-subtitle small text-muted">
                                                Alert Accounts Team after Invoice creation
                                            </div>

                                        </div>



                                        <!-- EDIT BUTTON -->
                                        <button type="button"
                                                class="btn btn-sm btn-warning text-dark ms-2 workflow-edit-btn"
                                                onclick="editWorkflowNode(event, this.closest('.workflow-node'), 'accounts')">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </button>
                                    </div>

                                </div>


                                <!-- CONNECTOR -->

                                <div class="py-2 text-secondary">

                                    <i class="bi bi-arrow-down fs-5"></i>

                                </div>


                                <!-- =================================
                                     END NODE
                                     ================================= -->

                                <div class="workflow-node border rounded-3 bg-white shadow-sm p-3 w-100"
                                     data-node="end">

                                    <div class="d-flex align-items-center">


                                        <div class="rounded-3 bg-secondary bg-opacity-10 text-secondary d-flex align-items-center justify-content-center me-3"
                                             style="width:42px;height:42px;">

                                            <i class="bi bi-check-lg fs-5"></i>

                                        </div>


                                        <div class="flex-grow-1">

                                            <div class="workflow-node-title fw-semibold text-dark">
                                                Process Completed
                                            </div>

                                            <div class="workflow-node-subtitle small text-muted">
                                                Workflow successfully completed
                                            </div>

                                        </div>

                                    </div>

                                </div>


                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     PROPERTIES
                     ================================================= -->

                <div class="col-xl-3 col-lg-3">

                    <div class="card border shadow-sm h-100">


                        <!-- HEADER -->

                        <div class="card-header bg-white border-0">

                            <h5 class="mb-0 fw-semibold">

                                <i class="bi bi-sliders me-2 text-primary"></i>

                                Properties

                            </h5>

                        </div>


                        <!-- BODY -->

                        <div class="card-body p-3">


                            <div id="workflowProperties">


                                <!-- STEP NAME -->

                                <div class="mb-3">

                                    <label for="propertyStepName"
                                           class="form-label fw-medium">

                                        Step Name

                                    </label>

                                    <input type="text"
                                           id="propertyStepName"
                                           class="form-control"
                                           value="Sales Order Created" />

                                </div>


                                <!-- TRIGGER TYPE -->

                                <div class="mb-3">

                                    <label for="propertyTriggerType"
                                           class="form-label fw-medium">

                                        Trigger Type

                                    </label>

                                    <select id="propertyTriggerType"
                                            class="form-select">

                                        <option selected>
                                            SAP Document Created
                                        </option>

                                        <option>
                                            SAP Document Updated
                                        </option>

                                        <option>
                                            Query Trigger
                                        </option>

                                    </select>

                                </div>


                                <!-- SAP OBJECT -->

                                <div class="mb-3">

                                    <label for="propertySapObject"
                                           class="form-label fw-medium">

                                        SAP Object

                                    </label>

                                    <select id="propertySapObject"
                                            class="form-select">

                                        <option selected>
                                            Sales Order - ORDR
                                        </option>

                                        <option>
                                            Delivery - ODLN
                                        </option>

                                        <option>
                                            A/R Invoice - OINV
                                        </option>

                                        <option>
                                            Purchase Order - OPOR
                                        </option>

                                    </select>

                                </div>


                                <!-- CONDITION -->

                                <div class="mb-3">

                                    <label for="propertyCondition"
                                           class="form-label fw-medium">

                                        Condition

                                    </label>

                                    <textarea id="propertyCondition"
                                              class="form-control"
                                              rows="4">DocStatus = 'O'</textarea>

                                </div>


                                <!-- APPLY CHANGES -->

                                <button type="button"
                                        class="btn btn-flow-pink w-100"
                                        onclick="saveNodeProperties()">
                                    <i class="bi bi-check2 me-1"></i>
                                    Apply Changes
                                </button>


                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@Html.Partial("_EditAlertModal")

@section Scripts {

    <script>

        /* =========================================================
               WORKFLOW NODE NAMES
               ========================================================= */

        var workflowNodeNames = {

            "trigger": "Sales Order Created",

            "notify": "Notify Delivery Team",

            "delivery-date": "Wait for Delivery Date",

            "delivery": "Wait for Delivery",

            "invoice": "Wait for A/R Invoice",

            "accounts": "Notify Accounts",

            "end": "Process Completed"

        };


        /* =========================================================
           SELECT WORKFLOW NODE
           ========================================================= */

        function selectWorkflowNode(element, type) {

            document
                .querySelectorAll(".workflow-node")
                .forEach(function (node) {

                    node.classList.remove(
                        "border-primary",
                        "border-2"
                    );

                });


            element.classList.add(
                "border-primary",
                "border-2"
            );


            var stepName =
                document.getElementById(
                    "propertyStepName"
                );


            if (workflowNodeNames[type]) {

                stepName.value =
                    workflowNodeNames[type];

            }


            updatePropertiesByType(type);

        }


        /* =========================================================
           UPDATE PROPERTY VALUES
           ========================================================= */

        function updatePropertiesByType(type) {

            var triggerType =
                document.getElementById(
                    "propertyTriggerType"
                );


            var sapObject =
                document.getElementById(
                    "propertySapObject"
                );


            var condition =
                document.getElementById(
                    "propertyCondition"
                );


            if (type === "trigger") {

                triggerType.value =
                    "SAP Document Created";

                sapObject.value =
                    "Sales Order - ORDR";

                condition.value =
                    "DocStatus = 'O'";

            }


            else if (type === "notify") {

                triggerType.value =
                    "SAP Document Updated";

                sapObject.value =
                    "Sales Order - ORDR";

                condition.value =
                    "Delivery notification required";

            }


            else if (type === "delivery-date") {

                triggerType.value =
                    "SAP Document Updated";

                sapObject.value =
                    "Sales Order - ORDR";

                condition.value =
                    "Expected Delivery Date IS NOT NULL";

            }


            else if (type === "delivery") {

                triggerType.value =
                    "SAP Document Created";

                sapObject.value =
                    "Delivery - ODLN";

                condition.value =
                    "BaseType = 17";

            }


            else if (type === "invoice") {

                triggerType.value =
                    "SAP Document Created";

                sapObject.value =
                    "A/R Invoice - OINV";

                condition.value =
                    "BaseType = 15";

            }


            else if (type === "accounts") {

                triggerType.value =
                    "SAP Document Created";

                sapObject.value =
                    "A/R Invoice - OINV";

                condition.value =
                    "Invoice created successfully";

            }

        }


        /* =========================================================
           ADD WORKFLOW NODE
           ========================================================= */

        function addWorkflowNode(type) {

            var flow =
                document.getElementById(
                    "workflowFlow"
                );


            var node =
                document.createElement("div");


            /*
             * Bootstrap classes
             */

            node.className =
                "workflow-node border rounded-3 bg-white shadow-sm p-3 w-100";


            var title =
                "New Workflow Step";


            var subtitle =
                "Configure this workflow step";


            var icon =
                "bi bi-plus-circle";


            var iconColor =
                "text-primary";


            var iconBackground =
                "bg-primary bg-opacity-10";


            if (type === "trigger") {

                title =
                    "SAP Event";

                subtitle =
                    "SAP document event";

                icon =
                    "bi bi-lightning-charge-fill";

                iconColor =
                    "text-primary";

                iconBackground =
                    "bg-primary bg-opacity-10";

            }


            else if (type === "query") {

                title =
                    "Query Trigger";

                subtitle =
                    "Trigger using SAP query";

                icon =
                    "bi bi-database-check";

                iconColor =
                    "text-primary";

                iconBackground =
                    "bg-primary bg-opacity-10";

            }


            else if (type === "condition") {

                title =
                    "Condition";

                subtitle =
                    "Evaluate workflow condition";

                icon =
                    "bi bi-signpost-split";

                iconColor =
                    "text-info";

                iconBackground =
                    "bg-info bg-opacity-10";

            }


            else if (type === "wait") {

                title =
                    "Wait";

                subtitle =
                    "Wait for configured event";

                icon =
                    "bi bi-hourglass-split";

                iconColor =
                    "text-warning";

                iconBackground =
                    "bg-warning bg-opacity-10";

            }


            else if (type === "whatsapp") {

                title =
                    "WhatsApp";

                subtitle =
                    "Send WhatsApp notification";

                icon =
                    "bi bi-whatsapp";

                iconColor =
                    "text-success";

                iconBackground =
                    "bg-success bg-opacity-10";

            }


            else if (type === "email") {

                title =
                    "Email";

                subtitle =
                    "Send email notification";

                icon =
                    "bi bi-envelope";

                iconColor =
                    "text-danger";

                iconBackground =
                    "bg-danger bg-opacity-10";

            }


            else if (type === "task") {

                title =
                    "Assign Task";

                subtitle =
                    "Assign task to user/team";

                icon =
                    "bi bi-person-check";

                iconColor =
                    "text-info";

                iconBackground =
                    "bg-info bg-opacity-10";

            }


            else if (type === "update") {

                title =
                    "Update SAP Field";

                subtitle =
                    "Update SAP document field";

                icon =
                    "bi bi-pencil-square";

                iconColor =
                    "text-primary";

                iconBackground =
                    "bg-primary bg-opacity-10";

            }


            /*
             * Bootstrap node markup
             */

            node.innerHTML =

                '<div class="d-flex align-items-center">' +

                '<div class="' +
                iconBackground +
                ' ' +
                iconColor +
                ' rounded-3 d-flex align-items-center justify-content-center me-3" ' +
                'style="width:42px;height:42px;">' +

                '<i class="' +
                icon +
                ' fs-5"></i>' +

                '</div>' +

                '<div class="flex-grow-1">' +

                '<div class="workflow-node-title fw-semibold text-dark">' +
                title +
                '</div>' +

                '<div class="workflow-node-subtitle small text-muted">' +
                subtitle +
                '</div>' +

                '</div>' +

                '<button type="button" ' +
                'class="btn btn-sm btn-warning text-dark ms-2 workflow-edit-btn" ' +
                'onclick="editWorkflowNode(event, this.closest(\'.workflow-node\'), \'" + type + "\')">' +
                '<i class="bi bi-pencil-square me-1"></i> Edit' +
                '</button>' +

                '</div>';

            node.onclick =
                function () {

                    selectWorkflowNode(
                        node,
                        type
                    );

                };


            /*
             * Bootstrap connector
             */

            var line =
                document.createElement("div");


            line.className =
                "py-2 text-secondary";


            line.innerHTML =
                '<i class="bi bi-arrow-down fs-5"></i>';


            flow.appendChild(line);

            flow.appendChild(node);


            selectWorkflowNode(
                node,
                type
            );


            setTimeout(function () {

                node.scrollIntoView({

                    behavior: "smooth",

                    block: "center"

                });

            }, 100);

        }


        /* =========================================================
           APPLY PROPERTY CHANGES
           ========================================================= */

        function saveNodeProperties() {

            var selected =
                document.querySelector(
                    ".workflow-node.border-primary"
                );


            if (!selected) {

                return;

            }


            var newName =
                document.getElementById(
                    "propertyStepName"
                ).value;


            if (!newName ||
                newName.trim() === "") {

                return;

            }


            var title =
                selected.querySelector(
                    ".workflow-node-title"
                );


            if (title) {

                title.textContent =
                    newName;

            }

        }



    </script>

}
