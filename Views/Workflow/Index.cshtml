@model IEnumerable<_10xFlow360.Controllers.WorkflowListItem>

@{
    ViewBag.Title = "Workflows";
}

<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- MAIN CARD -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <!-- ===================================================== -->
            <!-- CARD HEADER -->
            <!-- ===================================================== -->

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h4 class="mb-1">
                        Workflows
                    </h4>

                </div>


                <!-- ================================================= -->
                <!-- ADD NEW WORKFLOW -->
                <!-- ================================================= -->

                <button type="button"
                        class="btn btn-sm btn-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#createWorkflowModal">

                    <i class="bi bi-plus-lg me-1"></i>

                    Add New Workflow

                </button>

            </div>


            <!-- ===================================================== -->
            <!-- SUCCESS MESSAGE -->
            <!-- ================================================= -->

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">

                    @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            <!-- ===================================================== -->
            <!-- ERROR MESSAGE -->
            <!-- ===================================================== -->

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">

                    @TempData["ErrorMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            <!-- ===================================================== -->
            <!-- WORKFLOW TABLE -->
            <!-- ===================================================== -->

            <div class="table-responsive">

                <table id="workflowTable"
                       class="table">

                    <!-- ================================================= -->
                    <!-- TABLE HEADER -->
                    <!-- ================================================= -->

                    <thead class="table-light">

                        <tr>

                            <!-- WORKFLOW ID -->

                            <th style="width:70px;">
                                ID
                            </th>


                            <!-- WORKFLOW CODE -->

                            <th>
                                Workflow Code
                            </th>


                            <!-- WORKFLOW NAME -->

                            <th>
                                Workflow
                            </th>


                            <!-- SAP MODULE -->

                            <th>
                                SAP Module
                            </th>


                            <!-- VERSION -->

                            <th>
                                Version
                            </th>


                            <!-- STATUS -->

                            <th>
                                Status
                            </th>


                            <!-- UPDATED ON -->

                            <th>
                                Updated On
                            </th>


                            <!-- ACTIONS -->

                            <th class="text-center"
                                style="width:120px;">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <!-- ================================================= -->
                    <!-- TABLE BODY -->
                    <!-- ================================================= -->

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var workflow in Model)
                            {
                                <tr>

                                    <!-- ================================= -->
                                    <!-- WORKFLOW ID -->
                                    <!-- ================================= -->

                                    <td>
                                        @workflow.Id
                                    </td>


                                    <!-- ================================= -->
                                    <!-- WORKFLOW CODE -->
                                    <!-- ================================= -->

                                    <td>

                                        <span class="fw-semibold">
                                            @workflow.WorkflowCode
                                        </span>

                                    </td>


                                    <!-- ================================= -->
                                    <!-- WORKFLOW -->
                                    <!-- ================================= -->

                                    <td>

                                        <span class="fw-semibold">
                                            @workflow.WorkflowName
                                        </span>

                                    </td>


                                    <!-- ================================= -->
                                    <!-- SAP MODULE -->
                                    <!-- ================================= -->

                                    <td>
                                        @workflow.SAPModule
                                    </td>


                                    <!-- ================================= -->
                                    <!-- VERSION -->
                                    <!-- ================================= -->

                                    <td>
                                        @workflow.Version
                                    </td>


                                    <!-- ================================= -->
                                    <!-- STATUS -->
                                    <!-- ================================= -->

                                    <td>

                                        @if (workflow.Status == "Published")
                                        {
                                            <span class="badge bg-success">
                                                Published
                                            </span>
                                        }
                                        else if (workflow.Status == "Draft")
                                        {
                                            <span class="badge bg-secondary">
                                                Draft
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @workflow.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- ================================= -->
                                    <!-- UPDATED ON -->
                                    <!-- ================================= -->

                                    <td>
                                        @workflow.UpdatedOn
                                    </td>


                                    <!-- ================================= -->
                                    <!-- ACTIONS -->
                                    <!-- ================================= -->

                                    <td class="text-center">

                                        <!-- DESIGN -->

                                        <a href="@Url.Action(
                                                "Design",
                                                "Workflow",
                                                new
                                                {
                                                    workflowId = workflow.Id
                                                })"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Design">

                                            <i class="bi bi-diagram-3"></i>

                                        </a>


                                        <!-- AUTOMATE / TEST -->

                                        <a href="@Url.Action(
                                                "Test",
                                                "Workflow",
                                                new
                                                {
                                                    workflowId = workflow.Id
                                                })"
                                           class="btn btn-sm btn-outline-primary ms-1"
                                           title="Automate / Test">

                                            <i class="bi bi-play-circle-fill"></i>

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-diagram-3 fs-1"></i>

                                        <h5 class="mt-3">
                                            No workflows found
                                        </h5>

                                        <p class="mb-0">

                                            Click

                                            <strong>
                                                Add New Workflow
                                            </strong>

                                            to create your first workflow.

                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- CREATE WORKFLOW POPUP -->
<!-- ============================================================= -->

@Html.Partial(
    "_CreateWorkflow",
    new _10xFlow360.Models.WorkflowCreateVM()
)


<!-- ============================================================= -->
<!-- DATATABLE -->
<!-- ============================================================= -->

@section scripts {

    <script>

        $(document).ready(function () {

            $('#workflowTable').DataTable({

                /* =================================================
                   PAGE SIZE
                   ================================================= */

                pageLength: 10,


                /* =================================================
                   PAGE SIZE OPTIONS
                   ================================================= */

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],


                /* =================================================
                   FEATURES
                   ================================================= */

                searching: true,

                ordering: true,

                paging: true,

                pagingType: "full_numbers",

                info: true,


                /* =================================================
                   DATATABLE LAYOUT
                   ================================================= */

                dom:

                    '<"row align-items-center mb-3"' +

                    '<"col-md-6"l>' +

                    '<"col-md-6 d-flex justify-content-end"f>' +

                    '>' +

                    '<"row mb-2"' +

                    '<"col-12 d-flex justify-content-end"B>' +

                    '>' +

                    'rt' +

                    '<"row align-items-center mt-3"' +

                    '<"col-md-6"i>' +

                    '<"col-md-6 d-flex justify-content-end"p>' +

                    '>',


                /* =================================================
                   EXPORT BUTTONS
                   ================================================= */

                buttons: [

                    {
                        extend: 'copy',

                        text: 'Copy',

                        className:
                            'btn btn-sm btn-outline-secondary'
                    },

                    {
                        extend: 'excel',

                        text: 'Excel',

                        className:
                            'btn btn-sm btn-outline-secondary'
                    },

                    {
                        extend: 'pdf',

                        text: 'PDF',

                        className:
                            'btn btn-sm btn-outline-secondary'
                    },

                    {
                        extend: 'print',

                        text: 'Print',

                        className:
                            'btn btn-sm btn-outline-secondary'
                    }

                ],


                /* =================================================
                   LANGUAGE
                   ================================================= */

                language: {

                    search: "Search:",

                    searchPlaceholder: "Search...",

                    lengthMenu:
                        "_MENU_ entries per page",

                    info:
                        "Showing _START_ to _END_ of _TOTAL_ entries",

                    infoEmpty:
                        "Showing 0 to 0 of 0 entries",

                    emptyTable:
                        "No workflows found",

                    zeroRecords:
                        "No matching workflows found",

                    paginate: {

                        first: "«",

                        previous: "‹",

                        next: "›",

                        last: "»"

                    }

                },


                /* =================================================
                   COLUMN DEFINITIONS
                   ================================================= */

                columnDefs: [

                    {
                        // ID column
                        targets: 0,

                        orderable: true,

                        searchable: true
                    },

                    {
                        // Actions column
                        targets: 7,

                        orderable: false,

                        searchable: false
                    }

                ],


                /* =================================================
                   DRAW CALLBACK
                   ================================================= */

                drawCallback: function () {

                    var api = this.api();

                    /* =============================================
                       ACTIVE PAGINATION BUTTON
                       BOOTSTRAP DANGER = PINK/RED
                       ============================================= */

                    $('.dataTables_paginate .paginate_button.current')
                        .removeClass('btn-primary')
                        .addClass('btn-danger');


                    /* =============================================
                       BOOTSTRAP DATATABLES PAGINATION
                       ============================================= */

                    $('.dataTables_paginate .page-item.active .page-link')
                        .removeClass(
                            'bg-primary border-primary text-primary'
                        )
                        .addClass(
                            'bg-danger border-danger text-white'
                        );

                }

            });

        });

    </script>

}