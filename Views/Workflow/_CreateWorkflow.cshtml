@model _10xFlow360.Models.WorkflowCreateVM

<div class="modal fade"
     id="createWorkflowModal"
     tabindex="-1"
     aria-labelledby="createWorkflowModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <!-- ===================================================== -->
            <!-- HEADER -->
            <!-- ===================================================== -->

            <div class="modal-header">

                <div>

                    <h5 class="modal-title fw-semibold"
                        id="createWorkflowModalLabel">

                        <i class="bi bi-diagram-3 me-2"></i>

                        Create New Workflow

                    </h5>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- ===================================================== -->
            <!-- FORM -->
            <!-- ===================================================== -->

            @using (Html.BeginForm(
                "Create",
                "Workflow",
                FormMethod.Post,
                new
                {
                    @class = "needs-validation",
                    id = "createWorkflowForm"
                }))
            {

                @Html.AntiForgeryToken()


                <!-- ================================================= -->
                <!-- BODY -->
                <!-- ================================================= -->

                <div class="modal-body">

                    @Html.ValidationSummary(
                        true,
                        "",
                        new
                        {
                            @class = "text-danger mb-3"
                        })


                    <!-- ============================================= -->
                    <!-- WORKFLOW INFORMATION -->
                    <!-- ============================================= -->

                    <div class="fw-semibold mb-3">

                        <i class="bi bi-info-circle me-1"></i>

                        Workflow Information

                    </div>


                    <!-- ============================================= -->
                    <!-- ROW 1 -->
                    <!-- ============================================= -->

                    <div class="row g-3">


                        <!-- ========================================= -->
                        <!-- WORKFLOW NAME -->
                        <!-- ========================================= -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Workflow Name

                                <span class="text-danger">*</span>

                            </label>


                            @Html.TextBoxFor(
                                m => m.WorkflowName,
                                new
                                {
                                    @class = "form-control",
                                    placeholder =
                                        "Enter workflow name",
                                    autocomplete = "off",
                                    id = "WorkflowName"
                                })


                            @Html.ValidationMessageFor(
                                m => m.WorkflowName,
                                "",
                                new
                                {
                                    @class =
                                        "text-danger small"
                                })

                        </div>


                        <!-- ========================================= -->
                        <!-- SAP MODULE -->
                        <!-- ========================================= -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                SAP Module

                                <span class="text-danger">*</span>

                            </label>


                            @Html.DropDownListFor(
                                m => m.SapModule,

                                new SelectList(
                                    new[]
                                    {
                                        new
                                        {
                                            Value = "",
                                            Text =
                                                "-- Select Module --"
                                        },

                                        new
                                        {
                                            Value = "SALES",
                                            Text = "Sales"
                                        },

                                        new
                                        {
                                            Value = "PURCHASE",
                                            Text = "Purchase"
                                        },

                                        new
                                        {
                                            Value = "INVENTORY",
                                            Text = "Inventory"
                                        },

                                        new
                                        {
                                            Value = "FINANCE",
                                            Text = "Finance"
                                        },

                                        new
                                        {
                                            Value = "PRODUCTION",
                                            Text = "Production"
                                        },

                                        new
                                        {
                                            Value = "SERVICE",
                                            Text = "Service"
                                        }
                                    },

                                    "Value",
                                    "Text",

                                    Model == null
                                        ? ""
                                        : Model.SapModule
                                ),

                                new
                                {
                                    @class = "form-select",
                                    id = "SapModule"
                                })


                            @Html.ValidationMessageFor(
                                m => m.SapModule,
                                "",
                                new
                                {
                                    @class =
                                        "text-danger small"
                                })

                        </div>

                    </div>


                    <!-- ============================================= -->
                    <!-- ROW 2 -->
                    <!-- ============================================= -->

                    <div class="row g-3 mt-1">


                        <!-- ========================================= -->
                        <!-- COMPANY -->
                        <!-- ========================================= -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Company

                                <span class="text-danger">*</span>

                            </label>


                            @Html.DropDownListFor(
                                m => m.CompanyName,

                                new SelectList(
                                    new[]
                                    {
                                        new
                                        {
                                            Value = "",
                                            Text =
                                                "-- Select Company --"
                                        },

                                        new
                                        {
                                            Value =
                                                "10X Demo Company",
                                            Text =
                                                "10X Demo Company"
                                        }
                                    },

                                    "Value",
                                    "Text",

                                    Model == null
                                        ? ""
                                        : Model.CompanyName
                                ),

                                new
                                {
                                    @class = "form-select",
                                    id = "CompanyName"
                                })


                            @Html.ValidationMessageFor(
                                m => m.CompanyName,
                                "",
                                new
                                {
                                    @class =
                                        "text-danger small"
                                })

                        </div>


                        <!-- ========================================= -->
                        <!-- VERSION -->
                        <!-- ========================================= -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Version

                                <span class="text-danger">*</span>

                            </label>


                            @Html.TextBoxFor(
                                m => m.VersionNo,
                                new
                                {
                                    @class = "form-control",
                                    placeholder =
                                        "Example: V1.0",
                                    autocomplete = "off",
                                    id = "VersionNo"
                                })


                            @Html.ValidationMessageFor(
                                m => m.VersionNo,
                                "",
                                new
                                {
                                    @class =
                                        "text-danger small"
                                })

                        </div>

                    </div>


                    <!-- ============================================= -->
                    <!-- INFORMATION -->
                    <!-- ============================================= -->

                    <div class="alert alert-light border mt-4 mb-0">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-info-circle me-2 mt-1"></i>

                            <div>

                                <div class="fw-semibold">
                                    Workflow Creation
                                </div>

                                <small class="text-muted">

                                    Only the workflow header will be
                                    created at this stage.

                                    <br />

                                    After the header is saved, the
                                    generated Workflow ID will be used
                                    to create workflow steps.

                                </small>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- FOOTER -->
                <!-- ================================================= -->

                <div class="modal-footer">


                    <!-- ============================================= -->
                    <!-- CANCEL -->
                    <!-- ============================================= -->

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        <i class="bi bi-x-circle me-1"></i>

                        Cancel

                    </button>


                    <!-- ============================================= -->
                    <!-- CREATE HEADER -->
                    <!-- ============================================= -->

                    <button type="submit"
                            class="btn btn-danger"
                            id="createWorkflowBtn">

                        <i class="bi bi-save me-1"></i>

                        Create Workflow

                    </button>

                </div>

            }

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- CREATE WORKFLOW HEADER JAVASCRIPT -->
<!-- ============================================================= -->

<script>

    $(document).ready(function () {

        // =========================================================
        // CREATE WORKFLOW HEADER ONLY
        // =========================================================

        $("#createWorkflowForm").on(
            "submit",
            function (e) {

                e.preventDefault();


                // =================================================
                // GET VALUES
                // =================================================

                var workflowName =
                    $("#WorkflowName")
                        .val()
                        .trim();


                var sapModule =
                    $("#SapModule")
                        .val();


                var companyName =
                    $("#CompanyName")
                        .val();


                var versionNo =
                    $("#VersionNo")
                        .val()
                        .trim();


                // =================================================
                // VALIDATION
                // =================================================

                if (workflowName === "") {

                    alert(
                        "Please enter Workflow Name."
                    );

                    $("#WorkflowName").focus();

                    return;
                }


                if (!sapModule) {

                    alert(
                        "Please select SAP Module."
                    );

                    $("#SapModule").focus();

                    return;
                }


                if (!companyName) {

                    alert(
                        "Please select Company."
                    );

                    $("#CompanyName").focus();

                    return;
                }


                if (versionNo === "") {

                    alert(
                        "Please enter Version."
                    );

                    $("#VersionNo").focus();

                    return;
                }


                // =================================================
                // DISABLE BUTTON
                // =================================================

                var createButton =
                    $("#createWorkflowBtn");


                createButton
                    .prop("disabled", true);


                createButton.html(
                    '<span class="spinner-border spinner-border-sm me-1"></span>' +
                    'Creating...'
                );


                // =================================================
                // CREATE HEADER
                // =================================================

                $.ajax({

                    url:
                        '@Url.Action(
                            "Create",
                            "Workflow"
                        )',

                    type: "POST",

                    data: {

                        __RequestVerificationToken:
                            $(
                                "#createWorkflowForm " +
                                "input[name='__RequestVerificationToken']"
                            ).val(),

                        WorkflowName:
                            workflowName,

                        SapModule:
                            sapModule,

                        CompanyName:
                            companyName,

                        VersionNo:
                            versionNo

                    },


                    success:
                        function (response) {

                            // =====================================
                            // CHECK RESPONSE
                            // =====================================

                            if (!response.success) {

                                alert(
                                    response.message
                                );

                                resetCreateButton();

                                return;
                            }


                            // =====================================
                            // HEADER SUCCESS
                            // =====================================

                            alert(
                                "Workflow header created successfully.\n\n" +

                                "Workflow ID: " +
                                response.workflowId +
                                "\n" +

                                "Workflow Code: " +
                                response.workflowCode
                            );


                            // =====================================
                            // CLOSE MODAL
                            // =====================================

                            $("#createWorkflowModal")
                                .modal("hide");


                            // =====================================
                            // REFRESH WORKFLOW LIST
                            //
                            // The new Workflow ID is now available
                            // in the Workflow List.
                            // =====================================

                            window.location.href =
                                '@Url.Action(
                                    "Index",
                                    "Workflow"
                                )';

                        },


                    error:
                        function (xhr) {

                            var message =
                                "Unable to create workflow header.";


                            if (
                                xhr.responseJSON &&
                                xhr.responseJSON.message
                            ) {

                                message =
                                    xhr.responseJSON.message;
                            }


                            alert(message);


                            resetCreateButton();

                        }

                });

            }
        );


        // =========================================================
        // RESET CREATE BUTTON
        // =========================================================

        function resetCreateButton() {

            $("#createWorkflowBtn")
                .prop("disabled", false);


            $("#createWorkflowBtn")
                .html(
                    '<i class="bi bi-save me-1"></i>' +
                    'Create Workflow'
                );

        }

    });

</script>