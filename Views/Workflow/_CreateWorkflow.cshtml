@model _10xFlow360.Models.WorkflowCreateVM

<div class="modal fade"
     id="createWorkflowModal"
     tabindex="-1"
     aria-labelledby="createWorkflowModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <!-- HEADER -->

            <div class="modal-header">

                <div>

                    <h5 class="modal-title fw-semibold"
                        id="createWorkflowModalLabel">

                        <i class="bi bi-diagram-3 me-2"></i>
                        Create New Workflow

                    </h5>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- FORM -->

            @using (Html.BeginForm(
                "Create",
                "Workflow",
                FormMethod.Post,
                new { @class = "needs-validation" }))
            {
                @Html.AntiForgeryToken()

                <!-- BODY -->

                <div class="modal-body">

                    @Html.ValidationSummary(
                        true,
                        "",
                        new { @class = "text-danger mb-3" })


                    <!-- ============================= -->
                    <!-- ROW 1 -->
                    <!-- ============================= -->

                    <div class="row g-3">

                        <!-- WORKFLOW NAME -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Workflow Name
                                <span class="text-danger">*</span>

                            </label>

                            @Html.TextBoxFor(
                                m => m.WorkflowName,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter workflow name",
                                    autocomplete = "off"
                                })

                            @Html.ValidationMessageFor(
                                m => m.WorkflowName,
                                "",
                                new
                                {
                                    @class = "text-danger small"
                                })

                        </div>


                        <!-- SAP MODULE -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                SAP Module
                                <span class="text-danger">*</span>

                            </label>

                            @Html.DropDownListFor(
                                m => m.SapModule,

                                new SelectList(
                                    new[]
                                    {
                                        new
                                        {
                                            Value = "",
                                            Text = "-- Select Module --"
                                        },

                                        new
                                        {
                                            Value = "SALES",
                                            Text = "Sales"
                                        },

                                        new
                                        {
                                            Value = "PURCHASE",
                                            Text = "Purchase"
                                        },

                                        new
                                        {
                                            Value = "INVENTORY",
                                            Text = "Inventory"
                                        },

                                        new
                                        {
                                            Value = "FINANCE",
                                            Text = "Finance"
                                        },

                                        new
                                        {
                                            Value = "PRODUCTION",
                                            Text = "Production"
                                        },

                                        new
                                        {
                                            Value = "SERVICE",
                                            Text = "Service"
                                        }

                                    },
                                    "Value",
                                    "Text",
                                    Model == null
                                        ? ""
                                        : Model.SapModule
                                ),

                                new
                                {
                                    @class = "form-select"
                                })

                            @Html.ValidationMessageFor(
                                m => m.SapModule,
                                "",
                                new
                                {
                                    @class = "text-danger small"
                                })

                        </div>


                        <!-- ============================= -->
                        <!-- ROW 2 -->
                        <!-- ============================= -->
                        <!-- COMPANY -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Company
                                <span class="text-danger">*</span>

                            </label>

                            @Html.TextBoxFor(
                                m => m.CompanyName,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter company name",
                                    autocomplete = "off"
                                })

                            @Html.ValidationMessageFor(
                                m => m.CompanyName,
                                "",
                                new
                                {
                                    @class = "text-danger small"
                                })

                        </div>


                        <!-- VERSION -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Version
                                <span class="text-danger">*</span>

                            </label>

                            @Html.TextBoxFor(
                                m => m.VersionNo,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Example: 1.0",
                                    autocomplete = "off"
                                })

                            @Html.ValidationMessageFor(
                                m => m.VersionNo,
                                "",
                                new
                                {
                                    @class = "text-danger small"
                                })

                        </div>

                    </div>


                    <!-- ============================= -->
                    <!-- STATUS INFORMATION -->
                    <!-- ============================= -->

                    <div class="alert alert-light border mt-4 mb-0">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-info-circle me-2 mt-1"></i>

                            <div>

                                <div class="fw-semibold">
                                    Workflow Status
                                </div>

                                <small class="text-muted">

                                    The workflow will be created in
                                    <strong>Draft</strong> status.
                                    You can configure the workflow steps
                                    from the Design screen.

                                </small>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <!-- CANCEL -->

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        <i class="bi bi-x-circle me-1"></i>

                        Cancel

                    </button>


                    <!-- SAVE -->

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-save me-1"></i>

                        Save

                    </button>

                </div>

            }

        </div>

    </div>

</div>