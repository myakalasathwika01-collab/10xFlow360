@model _10xFlow360.Models.WorkflowCreateVM

<div class="modal fade"
     id="createWorkflowModal"
     tabindex="-1"
     aria-labelledby="createWorkflowModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <div class="modal-header">

                <h5 class="modal-title"
                    id="createWorkflowModalLabel">

                    <i class="bi bi-diagram-3 me-2"></i>

                    Create New Workflow

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- ================================================= -->
            <!-- FORM -->
            <!-- ================================================= -->

            @using (Html.BeginForm(
                "Create",
                "Workflow",
                FormMethod.Post,
                new { id = "createWorkflowForm" }))
            {

                @Html.AntiForgeryToken()


                <div class="modal-body">

                    <!-- Validation Summary -->

                    @Html.ValidationSummary(
                        true,
                        "",
                        new { @class = "text-danger" })


                    <div class="row g-3">


                        <!-- ===================================== -->
                        <!-- WORKFLOW NAME -->
                        <!-- ===================================== -->

                        <div class="col-md-12">

                            @Html.LabelFor(
                                model => model.WorkflowName,
                                new { @class = "form-label" })

                            @Html.TextBoxFor(
                                model => model.WorkflowName,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter workflow name"
                                })

                            @Html.ValidationMessageFor(
                                model => model.WorkflowName,
                                "",
                                new { @class = "text-danger" })

                        </div>


                        <!-- ===================================== -->
                        <!-- SAP MODULE -->
                        <!-- ===================================== -->

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.SapModule,
                                new { @class = "form-label" })

                            @Html.DropDownListFor(
                                model => model.SapModule,
                                new SelectList(
                                    new[]
                                    {
                                        new
                                        {
                                            Value = "Sales",
                                            Text = "Sales"
                                        },
                                        new
                                        {
                                            Value = "Purchase",
                                            Text = "Purchase"
                                        },
                                        new
                                        {
                                            Value = "Inventory",
                                            Text = "Inventory"
                                        },
                                        new
                                        {
                                            Value = "Finance",
                                            Text = "Finance"
                                        },
                                        new
                                        {
                                            Value = "Production",
                                            Text = "Production"
                                        },
                                        new
                                        {
                                            Value = "Service",
                                            Text = "Service"
                                        }
                                    },
                                    "Value",
                                    "Text"
                                ),
                                "Select SAP Module",
                                new
                                {
                                    @class = "form-select"
                                })

                            @Html.ValidationMessageFor(
                                model => model.SapModule,
                                "",
                                new { @class = "text-danger" })

                        </div>


                        <!-- ===================================== -->
                        <!-- COMPANY -->
                        <!-- ===================================== -->

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.CompanyName,
                                new { @class = "form-label" })

                            @Html.DropDownListFor(
                                model => model.CompanyName,
                                new SelectList(
                                    new[]
                                    {
                                        new
                                        {
                                            Value = "10X Demo Company",
                                            Text = "10X Demo Company"
                                        }
                                    },
                                    "Value",
                                    "Text"
                                ),
                                "Select Company",
                                new
                                {
                                    @class = "form-select"
                                })

                            @Html.ValidationMessageFor(
                                model => model.CompanyName,
                                "",
                                new { @class = "text-danger" })

                        </div>


                        <!-- ===================================== -->
                        <!-- VERSION -->
                        <!-- ===================================== -->

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.VersionNo,
                                new { @class = "form-label" })

                            @Html.TextBoxFor(
                                model => model.VersionNo,
                                new
                                {
                                    @class = "form-control",
                                    value = "V1.0"
                                })

                            @Html.ValidationMessageFor(
                                model => model.VersionNo,
                                "",
                                new { @class = "text-danger" })

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- FOOTER -->
                <!-- ================================================= -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save me-1"></i>

                        Save Workflow

                    </button>

                </div>

            }

        </div>

    </div>

</div>