    /* =========================================================
       SELECT SAP B1 USERS
       ========================================================= */

    var sapB1UsersModalInstance = null;

    function openSapB1UsersModal() {
        var modalElem = document.getElementById("selectSapB1UsersModal");
        if (!modalElem) return;

        try {
            if (window.bootstrap && bootstrap.Modal) {
                sapB1UsersModalInstance = bootstrap.Modal.getOrCreateInstance(modalElem, {
                    backdrop: 'static',
                    keyboard: true
                });
                sapB1UsersModalInstance.show();
            } else if (window.jQuery && typeof jQuery(modalElem).modal === "function") {
                jQuery(modalElem).modal("show");
            } else {
                modalElem.classList.add("show");
                modalElem.style.display = "block";
                modalElem.setAttribute("aria-hidden", "false");
            }
        } catch (e) {
            console.warn("Bootstrap modal error:", e);
            modalElem.classList.add("show");
            modalElem.style.display = "block";
            modalElem.setAttribute("aria-hidden", "false");
        }

        setTimeout(function () {
            var backdrops = document.querySelectorAll(".modal-backdrop");
            if (backdrops.length > 1) {
                backdrops[backdrops.length - 1].style.zIndex = "1058";
            }
            var search = document.getElementById("sapB1UserSearch");
            if (search) search.focus();
        }, 50);
    }

    function closeSapB1UsersModal() {
        var modalElem = document.getElementById("selectSapB1UsersModal");
        if (!modalElem) return;

        try {
            if (sapB1UsersModalInstance) {
                sapB1UsersModalInstance.hide();
            }
        } catch (e) {
            console.warn("Error hiding sap users modal:", e);
        }

        if (window.jQuery && typeof jQuery(modalElem).modal === "function") {
            try { jQuery(modalElem).modal("hide"); } catch (e) {}
        }

        modalElem.classList.remove("show");
        modalElem.style.display = "none";
        modalElem.setAttribute("aria-hidden", "true");

        cleanupChildModalBackdrop();
    }

    function filterSapB1Users() {
        var input = document.getElementById("sapB1UserSearch");
        var rows = document.querySelectorAll("#selectSapB1UsersModal .sap-user-row");
        var term = input ? input.value.toLowerCase().trim() : "";
        var visible = 0;

        rows.forEach(function (row) {
            var searchable = [
                row.getAttribute("data-user-name") || "",
                row.getAttribute("data-designation") || "",
                row.getAttribute("data-department") || "",
                row.getAttribute("data-mobile") || ""
            ].join(" ").toLowerCase();

            var match = searchable.indexOf(term) !== -1;
            row.style.display = match ? "grid" : "none";
            if (match) visible++;
        });

        var count = document.getElementById("sapB1UserCount");
        if (count) count.textContent = visible + " SAP B1 user" + (visible === 1 ? "" : "s");
    }

    function refreshSapB1Users() {
        var input = document.getElementById("sapB1UserSearch");
        if (input) input.value = "";

        var rows = document.querySelectorAll("#selectSapB1UsersModal .sap-user-row");
        rows.forEach(function (row) {
            row.style.display = "grid";
            var button = row.querySelector(".sap-user-add-btn");
            if (button && !button.classList.contains("added")) {
                button.disabled = false;
                button.innerHTML = '<i class="bi bi-plus-lg me-1"></i> Add';
            }
        });

        var count = document.getElementById("sapB1UserCount");
        if (count) count.textContent = rows.length + " SAP B1 users";
    }

    function addSapB1UserFromRow(row) {
        if (!row) return;
        var btn = row.querySelector(".sap-user-add-btn");
        var name = row.getAttribute("data-user-name") || "";
        var designation = row.getAttribute("data-designation") || "";
        var department = row.getAttribute("data-department") || "";
        var mobile = row.getAttribute("data-mobile") || "";
        addSapB1User(btn, name, name, designation, department, mobile, "");
    }

    function addSapB1User(button, name, code, designation, department, mobile, email) {
        var container = document.getElementById("alertModalRecipientsList");
        if (!container) return;

        var existingRows = container.querySelectorAll(".recipient-row");
        var duplicate = false;

        existingRows.forEach(function (row) {
            var codeInput = row.querySelector(".recipient-code");
            var nameInput = row.querySelector(".recipient-name");
            var phoneInput = row.querySelector(".recipient-phone");
            var existingCode = codeInput ? codeInput.value.trim().toLowerCase() : "";
            var existingName = nameInput ? nameInput.value.trim().toLowerCase() : "";
            var existingPhone = phoneInput ? phoneInput.value.trim().toLowerCase() : "";
            if ((code && existingCode === code.toLowerCase()) ||
                (!code && existingName === name.toLowerCase()) ||
                (mobile && existingPhone === mobile.toLowerCase())) {
                duplicate = true;
            }
        });

        if (duplicate) {
            if (button) {
                button.disabled = true;
                button.classList.add("added");
                button.innerHTML = '<i class="bi bi-check-lg me-1"></i> Added';
            }
            closeSapB1UsersModal();
            return;
        }

        // If the only row currently present is blank/empty, fill it instead of appending
        var firstRow = existingRows.length === 1 ? existingRows[0] : null;
        var firstRowName = firstRow ? (firstRow.querySelector(".recipient-name")?.value || "").trim() : "";
        var firstRowPhone = firstRow ? (firstRow.querySelector(".recipient-phone")?.value || "").trim() : "";

        if (firstRow && !firstRowName && !firstRowPhone) {
            var nInput = firstRow.querySelector(".recipient-name");
            var cInput = firstRow.querySelector(".recipient-code");
            var pInput = firstRow.querySelector(".recipient-phone");
            var eInput = firstRow.querySelector(".recipient-email");

            if (nInput) nInput.value = name;
            if (cInput) cInput.value = code;
            if (pInput) pInput.value = mobile;
            if (eInput) eInput.value = email || "";
            firstRow.setAttribute("data-recipient-source", "SAP B1 User");
            firstRow.setAttribute("data-designation", designation || "");
            firstRow.setAttribute("data-department", department || "");
        } else {
            var row = document.createElement("div");
            row.className = "recipient-row d-flex align-items-center gap-2";
            row.setAttribute("data-recipient-source", "SAP B1 User");
            row.setAttribute("data-designation", designation || "");
            row.setAttribute("data-department", department || "");

            row.innerHTML =
                '<div class="recipient-field recipient-name-field">' +
                '    <input type="text" class="form-control form-control-sm recipient-name" value="" placeholder="Name" />' +
                '</div>' +
                '<div class="recipient-field recipient-code-field">' +
                '    <input type="text" class="form-control form-control-sm recipient-code" value="" placeholder="Code *" />' +
                '</div>' +
                '<div class="recipient-field recipient-phone-field">' +
                '    <input type="text" class="form-control form-control-sm recipient-phone" value="" placeholder="WhatsApp mobile" />' +
                '</div>' +
                '<div class="recipient-field recipient-email-field">' +
                '    <input type="email" class="form-control form-control-sm recipient-email" value="" placeholder="Email" />' +
                '</div>' +
                '<button type="button" class="btn btn-sm btn-outline-secondary rounded-pill recipient-remove-btn" onclick="removeRecipientRow(this)">Remove</button>';

            var nameInput = row.querySelector(".recipient-name");
            var codeInput = row.querySelector(".recipient-code");
            var phoneInput = row.querySelector(".recipient-phone");
            var emailInput = row.querySelector(".recipient-email");

            if (nameInput) nameInput.value = name;
            if (codeInput) codeInput.value = code;
            if (phoneInput) phoneInput.value = mobile;
            if (emailInput) emailInput.value = email || "";

            container.appendChild(row);
        }

        if (button) {
            button.disabled = true;
            button.classList.add("added");
            button.innerHTML = '<i class="bi bi-check-lg me-1"></i> Added';
        }

        // Close the popup after selecting the user
        closeSapB1UsersModal();
    }


