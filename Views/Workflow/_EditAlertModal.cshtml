<!-- =========================================================
     OPEN SAVED QUERY MODAL
     ========================================================= -->

<div class="modal fade saved-query-popup-modal"
     id="openSavedQueryModal"
     tabindex="-1"
     aria-labelledby="openSavedQueryModalLabel"
     aria-hidden="true"
     data-bs-backdrop="static">

    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable saved-query-dialog">
        <div class="modal-content saved-query-modal-content">

            <!-- HEADER -->
            <div class="saved-query-modal-header">

                <div>
                    <h5 class="saved-query-modal-title"
                        id="openSavedQueryModalLabel">
                        Open Saved Query
                    </h5>

                    <div class="saved-query-modal-subtitle">
                        Select a SAP Business One saved query from OUQR and OQCN.
                    </div>
                </div>

                <button type="button"
                        class="saved-query-close-btn"
                        onclick="closeSavedQueryModal()"
                        aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>

            </div>

            <!-- BODY -->
            <div class="saved-query-modal-body">

                <!-- SEARCH -->
                <div class="saved-query-search-row">

                    <div class="saved-query-search-wrapper">
                        <input type="text"
                               id="savedQuerySearch"
                               class="form-control saved-query-search-input"
                               placeholder="Search by query name, category, or SQL"
                               autocomplete="off"
                               oninput="filterSavedQueries()" />
                    </div>

                    <button type="button"
                            class="btn saved-query-refresh-btn"
                            onclick="refreshSavedQueries()">
                        <i class="bi bi-arrow-repeat me-1"></i>
                        Refresh
                    </button>

                </div>

                <!-- COUNT -->
                <div class="saved-query-count"
                     id="savedQueryCount">
                    4 saved queries
                </div>

                <!-- EMPTY / QUERY LIST -->
                <div class="saved-query-list-container"
                     id="savedQueryList">

                    <div class="saved-query-row" onclick="selectSavedQuery(this.getAttribute('data-query-sql'))" data-query-name="Open Purchase Orders" data-query-category="Purchasing" data-query-sql="SELECT T0.&quot;DocEntry&quot;, T0.&quot;DocNum&quot;, T0.&quot;DocDate&quot;, T0.&quot;CardCode&quot;, T0.&quot;CardName&quot;, T0.&quot;DocTotal&quot; FROM OPOR T0 WHERE T0.&quot;DocStatus&quot; = 'O' ORDER BY T0.&quot;DocDate&quot; DESC;">
                        <div>
                            <div class="saved-query-name">Open Purchase Orders</div>
                            <div class="saved-query-meta">Category: Purchasing | Table: OPOR</div>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn saved-query-open-btn" onclick="event.stopPropagation(); selectSavedQuery(this.closest('.saved-query-row').getAttribute('data-query-sql'))">
                                Select
                            </button>
                        </div>
                    </div>

                    <div class="saved-query-row" onclick="selectSavedQuery(this.getAttribute('data-query-sql'))" data-query-name="Open Sales Orders" data-query-category="Sales" data-query-sql="SELECT T0.&quot;DocEntry&quot;, T0.&quot;DocNum&quot;, T0.&quot;DocDate&quot;, T0.&quot;DocDueDate&quot;, T0.&quot;CardCode&quot;, T0.&quot;CardName&quot;, T0.&quot;DocTotal&quot;, T0.&quot;DocStatus&quot; FROM ORDR T0 WHERE T0.&quot;DocStatus&quot; = 'O' ORDER BY T0.&quot;DocDate&quot; DESC;">
                        <div>
                            <div class="saved-query-name">Open Sales Orders</div>
                            <div class="saved-query-meta">Category: Sales | Table: ORDR</div>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn saved-query-open-btn" onclick="event.stopPropagation(); selectSavedQuery(this.closest('.saved-query-row').getAttribute('data-query-sql'))">
                                Select
                            </button>
                        </div>
                    </div>

                    <div class="saved-query-row" onclick="selectSavedQuery(this.getAttribute('data-query-sql'))" data-query-name="Overdue Invoices" data-query-category="Finance" data-query-sql="SELECT T0.&quot;DocEntry&quot;, T0.&quot;DocNum&quot;, T0.&quot;DocDueDate&quot;, T0.&quot;CardCode&quot;, T0.&quot;CardName&quot;, T0.&quot;DocTotal&quot; FROM OINV T0 WHERE T0.&quot;DocStatus&quot; = 'O' AND T0.&quot;DocDueDate&quot; &lt; CURRENT_DATE ORDER BY T0.&quot;DocDueDate&quot; ASC;">
                        <div>
                            <div class="saved-query-name">Overdue Invoices</div>
                            <div class="saved-query-meta">Category: Finance | Table: OINV</div>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn saved-query-open-btn" onclick="event.stopPropagation(); selectSavedQuery(this.closest('.saved-query-row').getAttribute('data-query-sql'))">
                                Select
                            </button>
                        </div>
                    </div>

                    <div class="saved-query-row" onclick="selectSavedQuery(this.getAttribute('data-query-sql'))" data-query-name="Low Stock Items" data-query-category="Inventory" data-query-sql="SELECT T0.&quot;ItemCode&quot;, T0.&quot;ItemName&quot;, T0.&quot;OnHand&quot;, T0.&quot;IsCommited&quot;, T0.&quot;OnOrder&quot;, (T0.&quot;OnHand&quot; - T0.&quot;IsCommited&quot; + T0.&quot;OnOrder&quot;) AS &quot;Available&quot; FROM OITM T0 WHERE T0.&quot;OnHand&quot; &lt; T0.&quot;MinStock&quot;;">
                        <div>
                            <div class="saved-query-name">Low Stock Items</div>
                            <div class="saved-query-meta">Category: Inventory | Table: OITM</div>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn saved-query-open-btn" onclick="event.stopPropagation(); selectSavedQuery(this.closest('.saved-query-row').getAttribute('data-query-sql'))">
                                Select
                            </button>
                        </div>
                    </div>

                    <div class="saved-query-empty-state"
                         id="savedQueryEmptyState"
                         style="display: none;">
                        No saved queries found.
                    </div>

                </div>

            </div>

        </div>
    </div>

</div>

