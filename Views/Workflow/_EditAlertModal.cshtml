    function filterSavedQueries() {
        var input = document.getElementById("savedQuerySearch");
        var rows = document.querySelectorAll("#openSavedQueryModal .saved-query-row");
        var term = input ? input.value.toLowerCase().trim() : "";
        var visible = 0;

        rows.forEach(function (row) {
            var searchable = (
                row.getAttribute("data-query-name") || ""
            ) + " " + (
                row.getAttribute("data-query-category") || ""
            ) + " " + (
                row.getAttribute("data-query-sql") || ""
            );

            var match = searchable.toLowerCase().indexOf(term) !== -1;
            row.style.display = match ? "grid" : "none";
            if (match) {
                visible++;
            }
        });

        var count = document.getElementById("savedQueryCount");
        if (count) {
            count.textContent = visible + " saved quer" + (visible === 1 ? "y" : "ies");
        }

        var empty = document.getElementById("savedQueryEmptyState");
        if (empty) {
            empty.style.display = visible === 0 ? "flex" : "none";
        }
    }

    function refreshSavedQueries() {
        var input = document.getElementById("savedQuerySearch");
        if (input) {
            input.value = "";
        }

        var rows = document.querySelectorAll("#openSavedQueryModal .saved-query-row");
        rows.forEach(function (row) {
            row.style.display = "grid";
        });

        var count = document.getElementById("savedQueryCount");
        if (count) {
            count.textContent = rows.length + " saved quer" + (rows.length === 1 ? "y" : "ies");
        }

        var empty = document.getElementById("savedQueryEmptyState");
        if (empty) {
            empty.style.display = rows.length === 0 ? "flex" : "none";
        }
    }

    function selectSavedQuery(queryText) {
        var queryInput = document.getElementById("alertModalQuery");
        if (queryInput) {
            queryInput.value = queryText || "";
        }
        closeSavedQueryModal();
    }

    function cleanupChildModalBackdrop() {
        var editModal = document.getElementById("editAlertModal");
        var isEditModalOpen = editModal && (editModal.classList.contains("show") || editModal.style.display === "block");

        var backdrops = document.querySelectorAll(".modal-backdrop");
        if (isEditModalOpen) {
            for (var i = 1; i < backdrops.length; i++) {
                backdrops[i].remove();
            }
            document.body.classList.add("modal-open");
            document.body.style.overflow = "hidden";
        } else {
            backdrops.forEach(function (b) { b.remove(); });
            document.body.classList.remove("modal-open");
            document.body.style.overflow = "";
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        var editModalElem = document.getElementById("editAlertModal");
        if (editModalElem) {
            editModalElem.addEventListener("click", function (e) {
                if (e.target === editModalElem) {
                    closeEditAlertModal();
                }
            });
        }

        var sapUsersModalElem = document.getElementById("selectSapB1UsersModal");
        if (sapUsersModalElem) {
            sapUsersModalElem.addEventListener("click", function (e) {
                if (e.target === sapUsersModalElem) {
                    closeSapB1UsersModal();
                }
            });
            sapUsersModalElem.addEventListener("hidden.bs.modal", function () {
                cleanupChildModalBackdrop();
            });
        }

        var savedQueryModalElem = document.getElementById("openSavedQueryModal");
        if (savedQueryModalElem) {
            savedQueryModalElem.addEventListener("click", function (e) {
                if (e.target === savedQueryModalElem) {
                    closeSavedQueryModal();
                }
            });
            savedQueryModalElem.addEventListener("hidden.bs.modal", function () {
                cleanupChildModalBackdrop();
            });
        }
    });</script>
