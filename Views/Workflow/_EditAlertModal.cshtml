<script>
    /* =========================================================
               WORKFLOW NODE NAMES
               ========================================================= */

    var workflowNodeNames = {

        "trigger": "Sales Order Created",

        "notify": "Notify Delivery Team",

        "delivery-date": "Wait for Delivery Date",

        "delivery": "Wait for Delivery",

        "invoice": "Wait for A/R Invoice",

        "accounts": "Notify Accounts",

        "end": "Process Completed"

    };


    /* =========================================================
       SELECT WORKFLOW NODE
       ========================================================= */

    function selectWorkflowNode(element, type) {

        document
            .querySelectorAll(".workflow-node")
            .forEach(function (node) {

                node.classList.remove(
                    "border-primary",
                    "border-2"
                );

            });


        element.classList.add(
            "border-primary",
            "border-2"
        );


        var stepName =
            document.getElementById(
                "propertyStepName"
            );


        if (workflowNodeNames[type]) {

            stepName.value =
                workflowNodeNames[type];

        }


        updatePropertiesByType(type);

    }


    /* =========================================================
       UPDATE PROPERTY VALUES
       ========================================================= */

    function updatePropertiesByType(type) {

        var triggerType =
            document.getElementById(
                "propertyTriggerType"
            );


        var sapObject =
            document.getElementById(
                "propertySapObject"
            );


        var condition =
            document.getElementById(
                "propertyCondition"
            );


        if (type === "trigger") {

            triggerType.value =
                "SAP Document Created";

            sapObject.value =
                "Sales Order - ORDR";

            condition.value =
                "DocStatus = 'O'";

        }


        else if (type === "notify") {

            triggerType.value =
                "SAP Document Updated";

            sapObject.value =
                "Sales Order - ORDR";

            condition.value =
                "Delivery notification required";

        }


        else if (type === "delivery-date") {

            triggerType.value =
                "SAP Document Updated";

            sapObject.value =
                "Sales Order - ORDR";

            condition.value =
                "Expected Delivery Date IS NOT NULL";

        }


        else if (type === "delivery") {

            triggerType.value =
                "SAP Document Created";

            sapObject.value =
                "Delivery - ODLN";

            condition.value =
                "BaseType = 17";

        }


        else if (type === "invoice") {

            triggerType.value =
                "SAP Document Created";

            sapObject.value =
                "A/R Invoice - OINV";

            condition.value =
                "BaseType = 15";

        }


        else if (type === "accounts") {

            triggerType.value =
                "SAP Document Created";

            sapObject.value =
                "A/R Invoice - OINV";

            condition.value =
                "Invoice created successfully";

        }

    }


    /* =========================================================
       ADD WORKFLOW NODE
       ========================================================= */

    function addWorkflowNode(type) {

        var flow =
            document.getElementById(
                "workflowFlow"
            );


        var node =
            document.createElement("div");


        /*
         * Bootstrap classes
         */

        node.className =
            "workflow-node border rounded-3 bg-white shadow-sm p-3 w-100";


        var title =
            "New Workflow Step";


        var subtitle =
            "Configure this workflow step";


        var icon =
            "bi bi-plus-circle";


        var iconColor =
            "text-primary";


        var iconBackground =
            "bg-primary bg-opacity-10";


        if (type === "trigger") {

            title =
                "SAP Event";

            subtitle =
                "SAP document event";

            icon =
                "bi bi-lightning-charge-fill";

            iconColor =
                "text-primary";

            iconBackground =
                "bg-primary bg-opacity-10";

        }


        else if (type === "query") {

            title =
                "Query Trigger";

            subtitle =
                "Trigger using SAP query";

            icon =
                "bi bi-database-check";

            iconColor =
                "text-primary";

            iconBackground =
                "bg-primary bg-opacity-10";

        }


        else if (type === "condition") {

            title =
                "Condition";

            subtitle =
                "Evaluate workflow condition";

            icon =
                "bi bi-signpost-split";

            iconColor =
                "text-info";

            iconBackground =
                "bg-info bg-opacity-10";

        }


        else if (type === "wait") {

            title =
                "Wait";

            subtitle =
                "Wait for configured event";

            icon =
                "bi bi-hourglass-split";

            iconColor =
                "text-warning";

            iconBackground =
                "bg-warning bg-opacity-10";

        }


        else if (type === "whatsapp") {

            title =
                "WhatsApp";

            subtitle =
                "Send WhatsApp notification";

            icon =
                "bi bi-whatsapp";

            iconColor =
                "text-success";

            iconBackground =
                "bg-success bg-opacity-10";

        }


        else if (type === "email") {

            title =
                "Email";

            subtitle =
                "Send email notification";

            icon =
                "bi bi-envelope";

            iconColor =
                "text-danger";

            iconBackground =
                "bg-danger bg-opacity-10";

        }


        else if (type === "task") {

            title =
                "Assign Task";

            subtitle =
                "Assign task to user/team";

            icon =
                "bi bi-person-check";

            iconColor =
                "text-info";

            iconBackground =
                "bg-info bg-opacity-10";

        }


        else if (type === "update") {

            title =
                "Update SAP Field";

            subtitle =
                "Update SAP document field";

            icon =
                "bi bi-pencil-square";

            iconColor =
                "text-primary";

            iconBackground =
                "bg-primary bg-opacity-10";

        }


        /*
         * Bootstrap node markup
         */

        node.innerHTML =

            '<div class="d-flex align-items-center">' +

            '<div class="' +
            iconBackground +
            ' ' +
            iconColor +
            ' rounded-3 d-flex align-items-center justify-content-center me-3" ' +
            'style="width:42px;height:42px;">' +

            '<i class="' +
            icon +
            ' fs-5"></i>' +

            '</div>' +

            '<div class="flex-grow-1">' +

            '<div class="workflow-node-title fw-semibold text-dark">' +
            title +
            '</div>' +

            '<div class="workflow-node-subtitle small text-muted">' +
            subtitle +
            '</div>' +

            '</div>' +

            '<button type="button" ' +
            'class="btn btn-sm btn-outline-warning ms-2 workflow-edit-btn" ' +
            'title="Edit Alert" ' +
            'onclick="editWorkflowNode(event, this.closest(\'.workflow-node\'), \'" + type + "\')">' +
            '<i class="bi bi-pencil-square"></i>' +
            '</button>' +

            '</div>';

        node.onclick =
            function () {

                selectWorkflowNode(
                    node,
                    type
                );

            };


        /*
         * Bootstrap connector
         */

        var line =
            document.createElement("div");


        line.className =
            "py-2 text-secondary";


        line.innerHTML =
            '<i class="bi bi-arrow-down fs-5"></i>';


        flow.appendChild(line);

        flow.appendChild(node);


        selectWorkflowNode(
            node,
            type
        );


        setTimeout(function () {

            node.scrollIntoView({

                behavior: "smooth",

                block: "center"

            });

        }, 100);

    }


    /* =========================================================
       EDIT WORKFLOW NODE (OPENS EDIT ALERT POPUP)
       ========================================================= */

    var currentEditingWorkflowNode = null;
    var alertModalInstance = null;

    function editWorkflowNode(event, element, type) {

        // Prevent the node click event from firing twice
        if (event) {
            event.stopPropagation();
        }

        // Select the workflow node and load its properties
        selectWorkflowNode(element, type);
        currentEditingWorkflowNode = element;

        // Pre-populate modal alert name from node title
        var nodeTitleElem = element ? element.querySelector(".workflow-node-title") : null;
        var nodeTitle = nodeTitleElem ? nodeTitleElem.textContent.trim() : "";

        var nameInput = document.getElementById("alertModalName");
        if (nameInput) {
            nameInput.value = nodeTitle || (workflowNodeNames[type] || "Purchase Order");
        }

        // Open the Edit Alert Modal
        openEditAlertModal();
    }

    /* =========================================================
       EDIT ALERT MODAL CONTROLS
       ========================================================= */

    function openEditAlertModal() {
        var modalElem = document.getElementById("editAlertModal");
        if (!modalElem) return;

        try {
            if (window.bootstrap && bootstrap.Modal) {
                if (!alertModalInstance) {
                    alertModalInstance = new bootstrap.Modal(modalElem, {
                        backdrop: 'static',
                        keyboard: true
                    });
                }
                alertModalInstance.show();
                return;
            }
        } catch (e) {
            console.warn("Bootstrap modal error:", e);
        }

        if (window.jQuery && typeof jQuery(modalElem).modal === "function") {
            jQuery(modalElem).modal("show");
        } else {
            modalElem.classList.add("show");
            modalElem.style.display = "block";
            document.body.classList.add("modal-open");
            if (!document.querySelector(".manual-modal-backdrop")) {
                var backdrop = document.createElement("div");
                backdrop.className = "modal-backdrop fade show manual-modal-backdrop";
                document.body.appendChild(backdrop);
            }
        }
    }

    function closeEditAlertModal() {
        var modalElem = document.getElementById("editAlertModal");
        if (!modalElem) return;

        // Ensure child modals are also closed if open
        closeSapB1UsersModal();
        closeSavedQueryModal();

        try {
            if (alertModalInstance) {
                alertModalInstance.hide();
            }
        } catch (e) {
            console.warn("Error hiding modal via bootstrap instance:", e);
        }

        if (window.jQuery && typeof jQuery(modalElem).modal === "function") {
            try { jQuery(modalElem).modal("hide"); } catch (e) {}
        }

        modalElem.classList.remove("show");
        modalElem.style.display = "none";
        modalElem.setAttribute("aria-hidden", "true");
        document.body.classList.remove("modal-open");
        document.body.style.overflow = "";
        var backdrop = document.querySelector(".manual-modal-backdrop");
        if (backdrop) {
            backdrop.remove();
        }
        var bsBackdrops = document.querySelectorAll(".modal-backdrop");
        bsBackdrops.forEach(function (b) { b.remove(); });
    }

    function saveAlertModal() {
        var nameInput = document.getElementById("alertModalName");
        var updatedName = nameInput ? nameInput.value.trim() : "";

        if (updatedName && currentEditingWorkflowNode) {
            var titleElem = currentEditingWorkflowNode.querySelector(".workflow-node-title");
            if (titleElem) {
                titleElem.textContent = updatedName;
            }

            // Also update the right properties panel Step Name input
            var stepNameInput = document.getElementById("propertyStepName");
            if (stepNameInput) {
                stepNameInput.value = updatedName;
            }
        }

        closeEditAlertModal();
        showSaveNotification("Alert configuration saved successfully.");
    }
    function addManualRecipient() {
        var container = document.getElementById("alertModalRecipientsList");
        if (!container) return;

