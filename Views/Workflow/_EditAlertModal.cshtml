<!-- =========================================================
     EDIT ALERT MODAL (POPUP)
     ========================================================= -->

<div class="modal fade alert-popup-modal" id="editAlertModal" tabindex="-1" aria-labelledby="editAlertModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" style="max-width: 960px; width: calc(100% - 32px);">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 14px; overflow: hidden;">

            <!-- MODAL HEADER (Vibrant Magenta/Pink) -->
            <div class="modal-header border-0 d-flex align-items-center justify-content-between bg-white text-dark" style="padding: 18px 24px;">
                <div>
                    <h4>
                        Edit
                    </h4>
                    <p class="mb-0 text-secondary" style="font-size: 0.85rem;">
                        Configure the query, trigger rules, message, and recipients.
                    </p>
                </div>
                <button type="button" class="alert-modal-close-btn" data-bs-dismiss="modal" aria-label="Close" onclick="closeEditAlertModal()">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- MODAL BODY -->
            <div class="modal-body p-4 custom-modal-scrollbar" style="background-color: #ffffff; max-height: 72vh; overflow-y: auto;">
                <form id="editAlertForm" onsubmit="event.preventDefault(); saveAlertModal();">

                    <!-- ROW 1: Alert Name & Alert Type -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="alertModalName" class="form-label fw-semibold text-secondary mb-1" style="font-size: 13px;">
                                Alert name
                            </label>
                            <input type="text" id="alertModalName" class="form-control form-control-sm" value="Purchase Order" placeholder="Enter alert name" />
                        </div>
                        <div class="col-md-6">
                            <label for="alertModalType" class="form-label fw-semibold text-secondary mb-1" style="font-size: 13px;">
                                Alert type
                            </label>
                            <select id="alertModalType" class="form-select form-select-sm">
                                <option value="Message">Message</option>
                                <option value="Approval" selected>Approval</option>
                                <option value="Document">Document</option>
                                <option value="Data">Data</option>
                            </select>
                        </div>
                    </div>

                    <!-- ROW 2: Severity & Frequency -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="alertModalSeverity" class="form-label fw-semibold text-secondary mb-1" style="font-size: 13px;">
                                Severity
                            </label>
                            <select id="alertModalSeverity" class="form-select form-select-sm">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="alertModalFrequency" class="form-label fw-semibold text-secondary mb-1" style="font-size: 13px;">
                                Frequency
                            </label>
                            <input type="number" id="alertModalFrequency" class="form-control form-control-sm" value="30" />
                        </div>
                    </div>

                    <!-- ROW 3: Frequency Unit & Condition Field -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="alertModalFrequencyUnit" class="form-label fw-semibold text-secondary mb-1" style="font-size: 13px;">
                                Frequency unit
                            </label>
                            <select id="alertModalFrequencyUnit" class="form-select form-select-sm">
                                <option value="Minutes" selected>Minutes</option>
                                <option value="Hours">Hours</option>
                                <option value="Days">Days</option>
                                <option value="Weeks">Weeks</option>
                                <option value="Months">Months</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="alertModalConditionField" class="form-label fw-semibold text-secondary mb-1" style="font-size: 13px;">
                                Condition field
                            </label>
                            <input type="text" id="alertModalConditionField" class="form-control form-control-sm" placeholder="Optional result column" />
                        </div>
                    </div>

                    <!-- ROW 4: Condition & Threshold -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="alertModalCondition" class="form-label fw-semibold text-secondary mb-1" style="font-size: 13px;">
                                Condition
                            </label>
                            <select id="alertModalCondition" class="form-select form-select-sm">
                                <option value="Rows exist" selected>Rows exist</option>
                                <option value="&gt;">&gt;</option>
                                <option value="&gt;=">&gt;=</option>
                                <option value="&lt;">&lt;</option>
                                <option value="&lt;=">&lt;=</option>
                                <option value="=">=</option>
                                <option value="!=">!=</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="alertModalThreshold" class="form-label fw-semibold text-secondary mb-1" style="font-size: 13px;">
                                Threshold
                            </label>
                            <input type="text" id="alertModalThreshold" class="form-control form-control-sm" placeholder="" />
                        </div>
                    </div>

                    <!-- ROW 5: Source & Unique Key Fields -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="alertModalSource" class="form-label fw-semibold text-secondary mb-1" style="font-size: 13px;">
                                Source
                            </label>
                            <select id="alertModalSource" class="form-select form-select-sm">
                                <option value="Data" selected>Data</option>
                                <option value="HANA">HANA</option>
                                <option value="SQL Server">SQL Server</option>
                                <option value="SAP Event">SAP Event</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="alertModalUniqueKeyFields" class="form-label fw-semibold text-secondary mb-1" style="font-size: 13px;">
                                Unique key fields
                            </label>
                            <input type="text" id="alertModalUniqueKeyFields" class="form-control form-control-sm" placeholder="DocEntry or ObjType,DocEntry" />
                        </div>
                    </div>

                    <!-- SECTION: HANA SELECT Query -->
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label for="alertModalQuery" class="form-label mb-0">
                                HANA SELECT query
                            </label>

                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    onclick="openSavedQuery()">
                                <i class="bi bi-folder2-open me-1"></i>
                                Open Saved Query
                            </button>
                        </div>

                        <textarea id="alertModalQuery"
                                  class="form-control font-monospace"
                                  rows="7"
                                  spellcheck="false"
                                  autocomplete="off"
                                  wrap="off">SELECT
    T0."DocEntry",
    T0."DocNum",
    T0."DocDate",
    T0."DocDueDate",
    T0."CardCode",
    T0."CardName",
    T0."DocTotal",
    T0."DocStatus"
FROM OPOR T0
ORDER BY T0."DocDate" DESC;</textarea>
                    </div>

                    <!-- SECTION: WhatsApp Message Template -->
                    <div class="mb-3">
                        <label for="alertModalTemplate"
                               class="form-label fw-semibold text-secondary mb-1"
                               style="font-size: 13px;">
                            WhatsApp message template
                        </label>

                        <textarea id="alertModalTemplate"
                                  class="form-control"
                                  rows="3"
                                  spellcheck="false"
                                  autocomplete="off"
                                  wrap="soft"
                                  style="
                  width: 100%;
                  min-width: 100%;
                  font-size: 13px;
                  line-height: 1.5;
                  background-color: #ffffff;
                  resize: vertical;
                  white-space: pre-wrap;
                  overflow: auto;
              ">Template TENX_ACTION_REQUIRED | {AlertName} | *Ref:* SO/{DocumentNo} | *Customer:* {PartyName} | *Action:* Review in SAP Business One.</textarea>
                    </div>

                    <!-- SECTION: Checkboxes -->
                    <div class="d-flex flex-wrap gap-4 align-items-center my-3 pt-1">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="chkAiRecommendations" checked />
                            <label class="form-check-label small fw-medium text-dark" for="chkAiRecommendations">
                                AI recommendations
                            </label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="chkReportInsights" />
                            <label class="form-check-label small fw-medium text-dark" for="chkReportInsights">
                                Report insights
                            </label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="chkOncePerUniqueKey" />
                            <label class="form-check-label small fw-medium text-dark" for="chkOncePerUniqueKey">
                                Once per unique key
                            </label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="chkActive" checked />
                            <label class="form-check-label small fw-medium text-dark" for="chkActive">
                                Active
                            </label>
                        </div>
                    </div>

                    <!-- SECTION: Recipients -->
                    <div class="mt-4">
                        <div class="fw-semibold text-secondary mb-2" style="font-size: 13.5px;">
                            Recipients
                        </div>                            <div id="alertModalRecipientsList" class="d-flex flex-column gap-2">
                            <!-- One recipient row is shown initially.
                            Additional rows are added only when the button is clicked. -->
                            <div class="recipient-row d-flex align-items-center gap-2">
                                <div class="recipient-field recipient-name-field">
                                    <input type="text"
                                           class="form-control form-control-sm recipient-name"
                                           value="manager - General"
                                           placeholder="Name" />
                                </div>

                                <div class="recipient-field recipient-code-field">
                                    <input type="text"
                                           class="form-control form-control-sm recipient-code"
                                           value="+91"
                                           placeholder="Code *" />
                                </div>

                                <div class="recipient-field recipient-phone-field">
                                    <input type="text"
                                           class="form-control form-control-sm recipient-phone"
                                           value="7075690467"
                                           placeholder="WhatsApp mobile" />
                                </div>

                                <div class="recipient-field recipient-email-field">
                                    <input type="email"
                                           class="form-control form-control-sm recipient-email"
                                           placeholder="Email" />
                                </div>

                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary rounded-pill recipient-remove-btn"
                                        onclick="removeRecipientRow(this)">
                                    Remove
                                </button>
                            </div>
                        </div>

                        <!-- Recipient Action Buttons -->
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button type="button" class="btn btn-light border rounded-pill px-3 py-1.5 text-dark small" style="font-size: 13px;" onclick="openSapB1UsersModal()">
                                <i class="bi bi-person-plus me-1"></i> Select SAP B1 Users
                            </button>
                            <button type="button" class="btn btn-light border rounded-pill px-3 py-1.5 text-dark small" style="font-size: 13px;" onclick="addManualRecipient()">
                                <i class="bi bi-plus me-1"></i> Add Manual Recipient
                            </button>
                        </div>
                    </div>

                </form>
            </div>

            <!-- MODAL FOOTER -->
            <div class="modal-footer bg-light border-0 py-2 px-4 justify-content-end">
                <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal" onclick="closeEditAlertModal()">
                    Cancel
                </button>
                <button type="button" class="btn btn-flow-pink rounded-pill px-4" onclick="saveAlertModal()">
                   Save Changes
                </button>
            </div>

        </div>
    </div>

</div>

