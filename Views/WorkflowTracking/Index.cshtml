@model _10xFlow360.Controllers.WorkflowTrackingViewModel

@{
    ViewBag.Title = "Process Tracking";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


<div class="container-fluid">

    <!-- =====================================================
         MAIN OUTER CARD
         ===================================================== -->

    <div class="card shadow-sm border-0">

        <!-- =================================================
             MAIN CARD BODY
             EVERYTHING IS INSIDE THIS CARD BODY
             ================================================= -->

        <div class="card-body">

            <!-- =====================================================
                 PAGE HEADER
                 ===================================================== -->

            <div class="d-flex flex-wrap
                        align-items-center
                        justify-content-between
                        border-bottom
                        pb-3
                        mb-4">

                <div class="border-0">

                    <h2 class="h5 mb-1 text-dark fw-semibold">
                        Process Tracking
                    </h2>

                    <p class="mb-0 text-muted small">
                        Track every running workflow and identify delays.
                    </p>

                </div>


                <!-- REFRESH -->

                <div class="mt-2 mt-md-0">

                    @using (Html.BeginForm(
                        "Refresh",
                        "WorkflowTracking",
                        FormMethod.Post,
                        new { @class = "m-0" }))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn text-white fw-semibold"
                                style="background-color:#e91e63; border-color:#e91e63; border-radius:6px;">

                            <i class="bi bi-arrow-clockwise me-1"></i>

                            Refresh

                        </button>
                    }

                </div>

            </div>


            <!-- =====================================================
                 SUCCESS MESSAGE
                 ===================================================== -->

            @if (TempData["TrackingMessage"] != null)
            {
                <div class="alert alert-success
                            d-flex
                            align-items-center
                            mb-4"
                     role="alert">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    <div>
                        @TempData["TrackingMessage"]
                    </div>

                </div>
            }


            <!-- =====================================================
                 SUMMARY CARDS
                 ===================================================== -->

            <div class="row g-3 mb-4">

                <!-- TOTAL INSTANCES -->

                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="card border shadow-sm h-100"
                         style="transition: all .2s ease; cursor: pointer;"
                         onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 .5rem 1rem rgba(0,0,0,.15)';"
                         onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='';">

                        <div class="card-body p-4">

                            <div class="d-flex flex-column gap-2">

                                <span class="text-muted small fw-semibold">
                                    TOTAL INSTANCES
                                </span>

                                <strong class="fs-3 text-primary">
                                    @Model.TotalInstances
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- IN PROGRESS -->

                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="card border shadow-sm h-100"
                         style="transition: all .2s ease; cursor: pointer;"
                         onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 .5rem 1rem rgba(0,0,0,.15)';"
                         onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='';">

                        <div class="card-body p-4">

                            <div class="d-flex flex-column gap-2">

                                <span class="text-muted small fw-semibold">
                                    IN PROGRESS
                                </span>

                                <strong class="fs-3 text-primary">
                                    @Model.InProgress
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- COMPLETED -->

                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="card border shadow-sm h-100"
                         style="transition: all .2s ease; cursor: pointer;"
                         onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 .5rem 1rem rgba(0,0,0,.15)';"
                         onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='';">

                        <div class="card-body p-4">

                            <div class="d-flex flex-column gap-2">

                                <span class="text-muted small fw-semibold">
                                    COMPLETED
                                </span>

                                <strong class="fs-3 text-success">
                                    @Model.Completed
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- OVERDUE -->

                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="card border shadow-sm h-100"
                         style="transition: all .2s ease; cursor: pointer;"
                         onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 .5rem 1rem rgba(0,0,0,.15)';"
                         onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='';">

                        <div class="card-body p-4">

                            <div class="d-flex flex-column gap-2">

                                <span class="text-muted small fw-semibold">
                                    OVERDUE
                                </span>

                                <strong class="fs-3 text-danger">
                                    @Model.Overdue
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 WORKFLOW INSTANCES
                 ===================================================== -->

            <div class="card border shadow-sm mb-4">

                <!-- CARD HEADER -->

                <div class="card-header bg-white">

                    <h3 class="h6 mb-0 fw-semibold text-dark">
                        Workflow Instances
                    </h3>

                </div>


                <!-- CARD BODY -->

                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover
                                      align-middle
                                      mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th class="px-3">
                                        Instance
                                    </th>

                                    <th class="px-3">
                                        Document
                                    </th>

                                    <th class="px-3">
                                        Customer
                                    </th>

                                    <th class="px-3">
                                        Current Stage
                                    </th>

                                    <th class="px-3">
                                        Owner
                                    </th>

                                    <th class="px-3">
                                        Elapsed
                                    </th>

                                    <th class="px-3">
                                        Status
                                    </th>

                                    <th class="px-3">
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item in Model.Instances)
                                {
                                    <tr>

                                        <!-- INSTANCE -->

                                        <td class="px-3">

                                            <strong>
                                                @item.InstanceId
                                            </strong>

                                        </td>


                                        <!-- DOCUMENT -->

                                        <td class="px-3">
                                            @item.Document
                                        </td>


                                        <!-- CUSTOMER -->

                                        <td class="px-3">
                                            @item.Customer
                                        </td>


                                        <!-- CURRENT STAGE -->

                                        <td class="px-3">
                                            @item.CurrentStage
                                        </td>


                                        <!-- OWNER -->

                                        <td class="px-3">
                                            @item.Owner
                                        </td>


                                        <!-- ELAPSED -->

                                        <td class="px-3">

                                            @if (item.Status == "Overdue")
                                            {
                                                <span class="text-danger fw-semibold">
                                                    @item.Elapsed
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @item.Elapsed
                                                </span>
                                            }

                                        </td>


                                        <!-- STATUS -->

                                        <td class="px-3">

                                            @if (item.Status == "Pending")
                                            {
                                                <span class="badge
                                                             rounded-pill
                                                             bg-warning
                                                             text-dark">

                                                    @item.Status

                                                </span>
                                            }
                                            else if (item.Status == "Running")
                                            {
                                                <span class="badge
                                                             rounded-pill
                                                             bg-primary">

                                                    @item.Status

                                                </span>
                                            }
                                            else if (item.Status == "Overdue")
                                            {
                                                <span class="badge
                                                             rounded-pill
                                                             bg-danger">

                                                    @item.Status

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge
                                                             rounded-pill
                                                             bg-success">

                                                    @item.Status

                                                </span>
                                            }

                                        </td>


                                        <!-- VIEW -->

                                        <td class="px-3">

                                            <a href="@Url.Action(
                                                "Index",
                                                "WorkflowTracking",
                                                new
                                                {
                                                    instanceId = item.InstanceId
                                                })"
                                               class="btn btn-sm text-white fw-semibold"
                                               style="background-color:#e91e63; border-color:#e91e63; border-radius:6px;">

                                                View

                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 LOWER SECTION
                 ===================================================== -->

            <div class="row g-4">


                <!-- =================================================
                     PROCESS TIMELINE
                     ================================================= -->

                <div class="col-12 col-lg-8">

                    <div class="card border shadow-sm h-100">

                        <!-- CARD HEADER -->

                        <div class="card-header bg-white border-0">

                            <h3 class="h6 mb-0 fw-semibold text-dark">

                                Process Timeline -
                                @Model.SelectedInstance.Document

                            </h3>

                        </div>


                        <!-- CARD BODY -->

                        <div class="card-body p-4">

                            <div class="border-start
                                        border-2
                                        ps-4">

                                @foreach (var step in Model.Timeline)
                                {

                                    <div class="position-relative mb-4">

                                        <!-- TIMELINE DOT -->

                                        <div class="position-absolute
                                                    bg-primary
                                                    rounded-circle
                                                    border
                                                    border-3
                                                    border-white
                                                    shadow-sm"
                                             style="
                                                width:14px;
                                                height:14px;
                                                left:-31px;
                                                top:4px;
                                             ">
                                        </div>


                                        <!-- CURRENT -->

                                        @if (step.IsCurrent)
                                        {
                                            <div class="mb-1">

                                                <span class="badge bg-warning text-dark">
                                                    Current
                                                </span>

                                            </div>
                                        }


                                        <!-- TIMELINE CONTENT -->

                                        <div>

                                            <strong class="d-block
                                                          text-dark
                                                          mb-1">

                                                @step.Title

                                            </strong>


                                            <span class="text-primary
                                                         small
                                                         d-block
                                                         mb-2">

                                                @step.Time

                                            </span>


                                            <p class="text-muted mb-0">

                                                @step.Description

                                            </p>

                                        </div>

                                    </div>

                                }

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     INSTANCE DETAILS
                     ================================================= -->

                <div class="col-12 col-lg-4">

                    <div class="card border shadow-sm h-100">

                        <!-- CARD HEADER -->

                        <div class="card-header bg-white border-0">

                            <h3 class="h6 mb-0 fw-semibold text-dark">

                                Instance Details

                            </h3>

                        </div>


                        <!-- CARD BODY -->

                        <div class="card-body p-4">


                            <!-- INSTANCE -->

                            <div class="mb-4">

                                <span class="text-muted
                                             small
                                             fw-semibold
                                             d-block
                                             mb-1">

                                    INSTANCE

                                </span>

                                <strong>
                                    @Model.SelectedInstance.InstanceId
                                </strong>

                            </div>


                            <!-- WORKFLOW -->

                            <div class="mb-4">

                                <span class="text-muted
                                             small
                                             fw-semibold
                                             d-block
                                             mb-1">

                                    WORKFLOW

                                </span>

                                <strong>
                                    @Model.SelectedInstance.Workflow
                                </strong>

                            </div>


                            <!-- SAP DOCUMENT -->

                            <div class="mb-4">

                                <span class="text-muted
                                             small
                                             fw-semibold
                                             d-block
                                             mb-1">

                                    SAP DOCUMENT

                                </span>

                                <strong>
                                    @Model.SelectedInstance.SapDocument
                                </strong>

                            </div>


                            <!-- CURRENT OWNER -->

                            <div class="mb-4">

                                <span class="text-muted
                                             small
                                             fw-semibold
                                             d-block
                                             mb-1">

                                    CURRENT OWNER

                                </span>

                                <strong>
                                    @Model.SelectedInstance.CurrentOwner
                                </strong>

                            </div>


                            <!-- CURRENT STAGE -->

                            <div class="mb-4">

                                <span class="text-muted
                                             small
                                             fw-semibold
                                             d-block
                                             mb-2">

                                    CURRENT STAGE

                                </span>

                                <span class="badge
                                             rounded-pill
                                             bg-warning
                                             text-dark">

                                    @Model.SelectedInstance.CurrentStage

                                </span>

                            </div>


                            <!-- SLA -->

                            <div class="mb-4">

                                <div class="d-flex
                                            align-items-center
                                            justify-content-between
                                            mb-2">

                                    <span class="text-muted
                                                 small
                                                 fw-semibold">

                                        SLA

                                    </span>

                                </div>


                                <div class="d-flex
                                            align-items-center
                                            justify-content-between
                                            mb-2">

                                    <span>
                                        @Model.SelectedInstance.SlaElapsed
                                    </span>

                                    <strong>
                                        @Model.SelectedInstance.SlaLimit
                                    </strong>

                                </div>


                                <div class="progress"
                                     role="progressbar"
                                     aria-valuenow="@Model.SelectedInstance.SlaPercentage"
                                     aria-valuemin="0"
                                     aria-valuemax="100">

                                    <div class="progress-bar bg-warning"
                                         style="width:@Model.SelectedInstance.SlaPercentage%;">
                                    </div>

                                </div>

                            </div>


                            <!-- ESCALATE -->

                            @using (Html.BeginForm(
                                "Escalate",
                                "WorkflowTracking",
                                FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="instanceId"
                                       value="@Model.SelectedInstance.InstanceId" />

                                <button type="submit"
                                        class="btn text-white fw-semibold w-100"
                                        style="background-color:#e91e63; border-color:#e91e63; border-radius:6px;">

                                    <i class="bi bi-exclamation-triangle me-1"></i>

                                    Escalate

                                </button>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>